# ===== 必填 =====

# Nexent 北向 API 地址
# - Nexent 用 docker 部署在本机：用 host.docker.internal（容器内访问宿主机）
# - Nexent 部署在局域网其他机器：填 http://192.168.x.x:5013
NEXENT_BASE=http://host.docker.internal:5013

# Nexent API Key
# 获取方式：Nexent 控制台 → 右上角头像 → 个人设置 → 生成 API Key
NEXENT_API_KEY=nexent-请替换为你的Key

# ===== 可选 =====

# 服务端口（容器内固定 8000，这里配置宿主机映射端口）
HOST_PORT=8000
