# 贷款合同审查规则库（40 条，四类各 10 条）
# 由 tools/gen_dataset.py 生成；legal_basis 一律 pending，禁止编造法规名称与文号。
- rule_id: R01
  category: 利率
  title: 利率基准约定不明
  risk_type: 利率-基准不明
  risk_level: 中
  scope:
  - 利率
  - 基准
  - LPR
  - 定价
  detect:
    method: hybrid
    keywords:
    - 利率
    - 市场
    - 同业
    - 自主确定
    regex: 利率[^。]{0,20}(市场|同业|自主|参照)
    llm_hint: 判断执行利率是否给出基准（LPR 品种）与加减点数、重定价方式
  evidence_spec:
  - 利率基准
  - 加减点数
  - 重定价方式
  suggestion_template: 建议明确利率基准与加减点数，例如：执行利率为一年期贷款市场报价利率（LPR）加 80BP，重定价日为每年 1 月 1 日，合同期内加减点数不变。
  suggestion_keywords:
  - LPR
  - 加减点数
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R02
  category: 利率
  title: 罚息/逾期利率超限
  risk_type: 利率-罚息超限
  risk_level: 高
  scope:
  - 逾期
  - 罚息
  - 复利
  - 上限
  detect:
    method: hybrid
    keywords:
    - 罚息
    - 逾期利率
    - 倍
    - 上浮
    regex: 罚息[^。]{0,30}([2-9]|[两三四五六七八九十])\s*倍
    llm_hint: 判断罚息利率是否显著高于合同利率（2 倍及以上）或明确排除上限
  evidence_spec:
  - 罚息倍数
  - 计收基数
  - 是否设上限
  suggestion_template: 建议改为：逾期罚息按合同利率上浮 50% 计收，并与利息、复利合计不超过法律与司法解释规定的上限。
  suggestion_keywords:
  - 上浮
  - 上限
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R03
  category: 利率
  title: 放款时预扣利息
  risk_type: 利率-利息预扣
  risk_level: 高
  scope:
  - 预扣
  - 放款
  - 本金
  - 利息
  detect:
    method: hybrid
    keywords:
    - 预扣
    - 预先扣除
    - 到账
    regex: (预扣|预先扣除)[^。]{0,20}利息
    llm_hint: 判断是否约定放款时预先扣除利息、费用，使实际到账低于合同本金
  evidence_spec:
  - 预扣金额
  - 实际到账金额
  - 计息基数
  suggestion_template: 建议删除预扣安排：利息自实际放款日起按季计收，放款时不得预扣利息或费用，实际到账金额应与合同本金一致。
  suggestion_keywords:
  - 实际放款日
  - 不得预扣
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R04
  category: 利率
  title: 复利计收对象与周期不明
  risk_type: 利率-复利不明
  risk_level: 中
  scope:
  - 复利
  - 计息
  - 结息
  detect:
    method: hybrid
    keywords:
    - 复利
    - 未付利息
    - 计收
    regex: 复利[^。]{0,30}(另行商定|内部管理|由.{0,8}确定)
    llm_hint: 判断复利的计收对象（仅未付利息）、基数与周期是否明确
  evidence_spec:
  - 复利对象
  - 计收基数
  - 计收周期
  suggestion_template: 建议明确复利计收对象与周期，例如：对未按期支付的利息按罚息利率计收复利，复利以未付利息为基数、按季计收，不计入本金。
  suggestion_keywords:
  - 未付利息
  - 按季
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R05
  category: 利率
  title: 出借人可单方调整利率且无通知义务
  risk_type: 利率-单方调息
  risk_level: 中
  scope:
  - 调息
  - 单方
  - 通知
  detect:
    method: hybrid
    keywords:
    - 单方调整
    - 调整利率
    - 无需通知
    regex: (单方|自行)[^。]{0,12}(调整|变更)[^。]{0,12}利率
    llm_hint: 判断利率调整是否可单方发起、是否附通知义务与触发条件
  evidence_spec:
  - 调整触发条件
  - 通知义务
  - 生效时点
  suggestion_template: 建议限定调息触发条件与程序：仅可依 LPR 变动同向调整，并应于调整前 5 个工作日书面通知借款人，未通知的调整对借款人不发生效力。
  suggestion_keywords:
  - 书面通知
  - LPR
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R06
  category: 利率
  title: 计息天数口径矛盾（360 与 365 并存）
  risk_type: 利率-计息天数矛盾
  risk_level: 低
  scope:
  - 计息
  - 日利率
  - 天数
  detect:
    method: hybrid
    keywords:
    - 三百六十
    - 三百六十五
    - 日利率
    regex: 三百六十(?!五)
    llm_hint: 判断同一合同内是否并存 360 与 365 两种计息口径
  evidence_spec:
  - 日利率折算基数
  - 计息天数规则
  - 冲突处理约定
  suggestion_template: 建议统一计息口径：日利率＝年利率÷365，计息天数按实际天数计算，删除 360 天口径及「以系统计算结果为准」的表述。
  suggestion_keywords:
  - '365'
  - 统一
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R07
  category: 利率
  title: LPR 变动后未约定重定价日与方式
  risk_type: 利率-重定价缺失
  risk_level: 中
  scope:
  - 重定价
  - LPR
  - 调整
  detect:
    method: hybrid
    keywords:
    - 重定价
    - 另行协商
    - LPR
    regex: (重定价|重新定价)[^。]{0,24}(另行协商|协商确定)
    llm_hint: 判断 LPR 变动后是否有明确的重定价日、重定价方式与加减点数处理
  evidence_spec:
  - 重定价日
  - 重定价方式
  - 加减点数是否固定
  suggestion_template: 建议补充重定价日与重定价方式：重定价日为每年 1 月 1 日，按当日同期限 LPR 加原加减点数确定新执行利率，无需另行协商。
  suggestion_keywords:
  - 重定价日
  - 加减点数
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R08
  category: 利率
  title: 手续费/管理费未折算年化
  risk_type: 利率-费用未折算
  risk_level: 中
  scope:
  - 费用
  - 管理费
  - 综合成本
  detect:
    method: hybrid
    keywords:
    - 管理费
    - 手续费
    - 服务费
    regex: (管理费|手续费|服务费)[^。]{0,24}(百分|%)
    llm_hint: 判断各项费用是否按年化口径折算并计入综合融资成本披露
  evidence_spec:
  - 费用项目
  - 收取方式
  - 折算年化结果
  suggestion_template: 建议将各项费用折算为年化综合融资成本并在合同中披露，或取消账户管理费，避免以费用形式变相提高实际利率。
  suggestion_keywords:
  - 年化
  - 综合融资成本
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R09
  category: 利率
  title: 提前还款违约金过高
  risk_type: 利率-提前还款违约金
  risk_level: 中
  scope:
  - 提前还款
  - 违约金
  - 补偿金
  detect:
    method: hybrid
    keywords:
    - 提前还款
    - 违约金
    - 补偿金
    regex: 提前还款[^。]{0,24}(百分之[三-九]|[3-9]\s*%)
    llm_hint: 判断提前还款违约/补偿金是否超过剩余本金 3% 或明显高于资金重配成本
  evidence_spec:
  - 违约金比例
  - 计算基数
  - 是否设上限
  suggestion_template: 建议下调提前还款违约金，例如按提前还款金额的 1% 计收，且不超过对应三个月利息，已计收利息按实际用款天数结算。
  suggestion_keywords:
  - 1%
  - 三个月利息
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R10
  category: 利率
  title: 起息日与放款日不一致且未说明
  risk_type: 利率-起息日不一致
  risk_level: 低
  scope:
  - 起息日
  - 放款日
  - 计息
  detect:
    method: hybrid
    keywords:
    - 起息日
    - 放款日
    - 签订之日
    regex: 起息日[^。]{0,24}签订之日
    llm_hint: 判断起息日是否与出借人实际放款日不一致，且未说明理由
  evidence_spec:
  - 起息日
  - 实际放款日
  - 差异说明
  suggestion_template: 建议将起息日统一为实际放款日：利息自借款本金划付至借款人账户之日起计算，避免签约日至放款日之间产生无对价计息。
  suggestion_keywords:
  - 实际放款日
  - 划付
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R11
  category: 担保
  title: 保证方式未明确为连带责任保证
  risk_type: 担保-保证方式不明
  risk_level: 中
  scope:
  - 保证
  - 连带责任
  - 担保方式
  detect:
    method: hybrid
    keywords:
    - 提供保证
    - 保证方式
    - 连带责任
    regex: 提供保证[^。]{0,12}(方式|依照法律)
    llm_hint: 判断是否仅写「提供保证」而未明确为连带责任保证
  evidence_spec:
  - 保证方式
  - 是否连带
  - 主张路径
  suggestion_template: 建议明确保证方式：保证人自愿为该笔借款提供连带责任保证，出借人有权在主债务履行期限届满后直接要求保证人承担保证责任。
  suggestion_keywords:
  - 连带责任保证
  - 直接要求
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R12
  category: 担保
  title: 担保范围未覆盖利息与实现债权费用
  risk_type: 担保-担保范围不足
  risk_level: 中
  scope:
  - 担保范围
  - 利息
  - 实现债权费用
  detect:
    method: hybrid
    keywords:
    - 担保范围
    - 仅限
    - 不包括
    regex: 担保范围[^。]{0,24}(仅限|不包括)
    llm_hint: 判断担保范围是否覆盖本金、利息、罚息、违约金与实现债权费用
  evidence_spec:
  - 担保范围列举
  - 是否含实现债权费用
  - 是否含罚息
  suggestion_template: 建议扩大担保范围至本金、利息、罚息、复利、违约金、损害赔偿金及实现债权的费用（含诉讼费、律师费、保全费）。
  suggestion_keywords:
  - 实现债权的费用
  - 罚息
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R13
  category: 担保
  title: 保证期间约定不明或过短
  risk_type: 担保-保证期间过短
  risk_level: 高
  scope:
  - 保证期间
  - 保证责任
  - 六个月
  detect:
    method: hybrid
    keywords:
    - 保证期间
    - 三个月
    - 期间届满
    regex: 保证期间[^。]{0,24}(三个月|[一二三四五]个月|六个月)
    llm_hint: 判断保证期间是否短于主债务履行期限届满后六个月，或约定不明
  evidence_spec:
  - 保证期间长度
  - 起算点
  - 主张方式
  suggestion_template: 建议保证期间不短于主债务履行期限届满之日起三年，并明确期间内出借人主张权利的方式。
  suggestion_keywords:
  - 三年
  - 主张
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R14
  category: 担保
  title: 抵押物未约定办理登记及登记责任
  risk_type: 担保-抵押未登记
  risk_level: 高
  scope:
  - 抵押
  - 登记
  - 优先受偿
  detect:
    method: hybrid
    keywords:
    - 抵押
    - 登记
    - 抵押权
    regex: 抵押权[^。]{0,12}签订时设立|(无需|不)办理抵押登记
    llm_hint: 判断是否约定抵押登记的义务、期限与责任，以及抵押权设立时点表述是否正确
  evidence_spec:
  - 登记义务人
  - 登记期限
  - 抵押权设立时点
  suggestion_template: 建议约定登记义务与放款前提：抵押人应于合同签订后 15 个工作日内配合办理抵押登记，登记完成后方可放款；因抵押人原因未按期登记的，出借人有权解除合同并宣布借款提前到期。
  suggestion_keywords:
  - 办理抵押登记
  - 放款
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R15
  category: 担保
  title: 抵押率超限且未约定价值重估
  risk_type: 担保-抵押率超限
  risk_level: 中
  scope:
  - 抵押率
  - 评估价值
  - 重估
  detect:
    method: hybrid
    keywords:
    - 抵押率
    - 评估
    - 重估
    regex: 抵押率[^。]{0,24}(百分之[一二三四五六七八九]十[5-9]|1[0-9]{2}%)
    llm_hint: 判断抵押率是否超过审慎上限（通常 70%），以及是否约定抵押物价值重估
  evidence_spec:
  - 抵押物评估价值
  - 担保债权金额
  - 抵押率
  - 重估安排
  suggestion_template: 建议将抵押率控制在 70% 以内，并约定每年至少一次价值重估；重估后抵押率超限的，出借人有权要求追加担保。
  suggestion_keywords:
  - 抵押率
  - 重估
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R16
  category: 担保
  title: 最高额担保未约定最高债权额
  risk_type: 担保-最高额不明
  risk_level: 高
  scope:
  - 最高额
  - 最高债权额
  - 担保范围
  detect:
    method: hybrid
    keywords:
    - 最高额
    - 最高额度
    - 债权额
    regex: 最高额[^。]{0,30}(为准|不持异议)
    llm_hint: 判断最高额担保是否写明具体最高债权额及其构成
  evidence_spec:
  - 最高债权额
  - 是否含利息费用
  - 超出部分处理
  suggestion_template: 建议明确最高债权额及构成：所担保的最高债权额为人民币【】万元，包括本金、利息、罚息、复利、违约金及实现债权的费用，超出部分保证人不承担责任。
  suggestion_keywords:
  - 最高债权额
  - 超出部分
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R17
  category: 担保
  title: 质物交付与保管责任不明
  risk_type: 担保-质物交付不明
  risk_level: 中
  scope:
  - 质押
  - 质物
  - 交付
  - 保管
  detect:
    method: hybrid
    keywords:
    - 质物
    - 交付
    - 保管
    regex: 质物[^。]{0,24}(另行商定|自行保管)
    llm_hint: 判断质物的交付期限、交付方式与保管责任是否明确
  evidence_spec:
  - 交付期限
  - 交付方式
  - 保管责任与风险承担
  suggestion_template: 建议明确质物交付期限、交付方式与保管责任：出质人应于合同签订后 5 个工作日内交付权利凭证，保管期间毁损灭失风险由出质人承担，未经出借人同意不得处分质物。
  suggestion_keywords:
  - 交付
  - 保管
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R18
  category: 担保
  title: 担保人配偶同意缺位
  risk_type: 担保-配偶同意缺位
  risk_level: 中
  scope:
  - 保证人
  - 配偶
  - 夫妻共同债务
  detect:
    method: hybrid
    keywords:
    - 配偶
    - 夫妻
    - 共同财产
    regex: (配偶|夫妻)[^。]{0,24}(同意|另行)
    llm_hint: 判断自然人担保人是否取得配偶书面同意，以覆盖夫妻共同财产
  evidence_spec:
  - 配偶是否签署
  - 同意文件形式
  - 共同财产范围
  suggestion_template: 建议要求保证人配偶签署同意担保的书面文件，并留存身份证明与签署过程记录，避免日后以夫妻共同债务范围为由抗辩。
  suggestion_keywords:
  - 配偶
  - 书面文件
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R19
  category: 担保
  title: 保证人资格瑕疵（公益法人/国家机关）
  risk_type: 担保-保证人资格瑕疵
  risk_level: 高
  scope:
  - 保证人
  - 资格
  - 事业单位
  detect:
    method: hybrid
    keywords:
    - 事业单位
    - 财政
    - 保证人资格
    regex: (事业单位|国家机关|社会团体)[^。]{0,24}保证
    llm_hint: 判断保证人是否属于法律禁止担任保证人的主体（国家机关、公益性事业单位等）
  evidence_spec:
  - 保证人主体性质
  - 是否营利法人
  - 代偿能力
  suggestion_template: 建议更换保证人：以营利法人或具备代偿能力的自然人为保证人，并在签约前核验其主体资格与代偿能力，避免因保证人资格瑕疵导致保证合同无效。
  suggestion_keywords:
  - 营利法人
  - 代偿能力
  legal_basis:
    name: 待核验
    article: 待核验
    url: ''
    verify_status: pending
  disabled: false
- rule_id: R20
  category: 担保
  title: 约定排除司法程序自行处置担保物
  risk_type: 担保-自行处置担保物
  risk_level: 高
  scope:
  - 担保物
  - 处置
  - 拍卖
  - 流质
  detect:
    method: hybrid
