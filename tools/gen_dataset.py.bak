    _para(doc, "", size=10.5, indent=False, space_after=4)
    for i, body in enumerate(bodies[5:], 7):
        _para(doc, f"{clause_no(i)}{SEP}{body}", size=10.5, indent=True, space_after=3, line_spacing=1.45)
    save_docx(doc, path)


def write_b04(path: Path):
    """纯图片扫描件：所有正文渲染成位图后嵌入，文档无文字层。"""
    from PIL import Image, ImageDraw, ImageFont

    lines = ["示例商业银行示例分行　流动资金借款合同", ""]
    for i, body in enumerate(_boundary_body(8, "b04"), 1):
        lines.append(f"{clause_no(i)}{SEP}{body}")
        lines.append("")
    lines.append(DISCLAIMER)

    wrapped: list[str] = []
    for line in lines:
        if not line:
            wrapped.append("")
            continue
        buf = ""
        for ch in line:
            if len(buf) >= 38:
                wrapped.append(buf)
                buf = ""
            buf += ch
        wrapped.append(buf)

    font = ImageFont.truetype("C:/Windows/Fonts/msyh.ttc", 26)
    per_page = 34
    pages = [wrapped[i:i + per_page] for i in range(0, len(wrapped), per_page)]
    tmp = path.parent / "_tmp_b04"
    tmp.mkdir(parents=True, exist_ok=True)
    pngs = []
    for idx, page in enumerate(pages, 1):
        img = Image.new("RGB", (1240, 1754), "white")
        draw = ImageDraw.Draw(img)
        y = 90
        for line in page:
            draw.text((100, y), line, fill=(20, 20, 20), font=font)
            y += 46
        draw.text((100, 1690), f"第 {idx} 页 / 共 {len(pages)} 页", fill=(90, 90, 90), font=font)
        fp = tmp / f"page{idx}.png"
        img.save(fp, format="PNG")
        pngs.append(fp)

    doc = _init_doc()
    for idx, fp in enumerate(pngs):
        doc.add_picture(str(fp), width=Cm(15.0))
        if idx != len(pngs) - 1:
            doc.add_page_break()
    save_docx(doc, path)


