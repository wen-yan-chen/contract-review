        section="担保",
        common="为保证本合同项下债务的履行，保证人向出借人提供保证担保。",
        ok="保证人自愿为该笔借款提供连带责任保证，出借人有权直接要求保证人在保证范围内承担保证责任。",
        bad="保证人自愿为该笔借款提供保证，保证责任的范围与方式依照法律规定确定。",
    ),
    _rule(
        rule_id="R12", category="担保", risk_type="担保-担保范围不足", level="中",
        title="担保范围未覆盖利息与实现债权费用",
        scope=["担保范围", "利息", "实现债权费用"],
        keywords=["担保范围", "仅限", "不包括"],
        regex=r"担保范围[^。]{0,24}(仅限|不包括)",
        llm_hint="判断担保范围是否覆盖本金、利息、罚息、违约金与实现债权费用",
        evidence=["担保范围列举", "是否含实现债权费用", "是否含罚息"],
        suggestion="建议扩大担保范围至本金、利息、罚息、复利、违约金、损害赔偿金及实现债权的费用（含诉讼费、律师费、保全费）。",
        sug_keywords=["实现债权的费用", "罚息"],
        problem="担保范围被限缩为借款本金，利息、罚息、违约金及实现债权费用被排除在担保之外，一旦发生代偿，出借人对利息与费用的债权将失去优先受偿地位。",
        section="担保",
        common="本合同项下担保的范围按下列约定确定。",
        ok="担保范围包括借款本金、利息、罚息、复利、违约金、损害赔偿金以及出借人实现债权的费用。",
        bad="担保范围仅限借款本金，利息、罚息、违约金及出借人实现债权的费用不在担保范围之内。",
    ),
    _rule(
        rule_id="R13", category="担保", risk_type="担保-保证期间过短", level="高",
        title="保证期间约定不明或过短",
        scope=["保证期间", "保证责任", "六个月"],
        keywords=["保证期间", "三个月", "期间届满"],
        regex=r"保证期间[^。]{0,24}(三个月|[一二三四五]个月|六个月)",
        llm_hint="判断保证期间是否短于主债务履行期限届满后六个月，或约定不明",
        evidence=["保证期间长度", "起算点", "主张方式"],
        suggestion="建议保证期间不短于主债务履行期限届满之日起三年，并明确期间内出借人主张权利的方式。",
        sug_keywords=["三年", "主张"],
        problem="保证期间被压缩为主债务履行期限届满之日起三个月，短于法定最低保护水平，出借人稍有迟延即丧失对保证人的权利，直接导致担保落空。",
        section="担保",
        common="保证期间自本合同项下债务履行期限届满之日起计算。",
        ok="保证期间为主债务履行期限届满之日起三年，期间内出借人有权要求保证人承担保证责任。",
        bad="保证期间为主债务履行期限届满之日起三个月，期间届满保证人不再承担任何保证责任。",
    ),
    _rule(
        rule_id="R14", category="担保", risk_type="担保-抵押未登记", level="高",
        title="抵押物未约定办理登记及登记责任",
        scope=["抵押", "登记", "优先受偿"],
        keywords=["抵押", "登记", "抵押权"],
        regex=r"抵押权[^。]{0,12}签订时设立|(无需|不)办理抵押登记",
        llm_hint="判断是否约定抵押登记的义务、期限与责任，以及抵押权设立时点表述是否正确",
        evidence=["登记义务人", "登记期限", "抵押权设立时点"],
        suggestion="建议约定登记义务与放款前提：抵押人应于合同签订后 15 个工作日内配合办理抵押登记，登记完成后方可放款；因抵押人原因未按期登记的，出借人有权解除合同并宣布借款提前到期。",
        sug_keywords=["办理抵押登记", "放款"],
        problem="约定抵押权自合同签订时设立且双方均无登记义务，混淆了抵押合同的生效与抵押权的设立，未登记即不享有优先受偿权，担保形同虚设。",
        section="担保",
        common="抵押人自愿以其名下不动产为本合同项下债务提供抵押担保。",
        ok="抵押人应于本合同签订之日起十五个工作日内配合办理抵押登记，登记完成后方可放款，登记费用由抵押人承担。",
        bad="抵押物由抵押人继续占有使用，双方均无办理抵押登记的义务，抵押权自本合同签订时设立。",
    ),
    _rule(
        rule_id="R15", category="担保", risk_type="担保-抵押率超限", level="中",
        title="抵押率超限且未约定价值重估",
        scope=["抵押率", "评估价值", "重估"],
        keywords=["抵押率", "评估", "重估"],
        regex=r"抵押率[^。]{0,24}(百分之[一二三四五六七八九]十[5-9]|1[0-9]{2}%)",
        llm_hint="判断抵押率是否超过审慎上限（通常 70%），以及是否约定抵押物价值重估",
        evidence=["抵押物评估价值", "担保债权金额", "抵押率", "重估安排"],
        suggestion="建议将抵押率控制在 70% 以内，并约定每年至少一次价值重估；重估后抵押率超限的，出借人有权要求追加担保。",
        sug_keywords=["抵押率", "重估"],
        problem="担保债权本息合计远超抵押物评估价值，抵押率按 125% 执行且合同期内不重估，抵押物价值波动时缺乏缓冲，处置后不足清偿的风险完全由出借人承担。",
        section="担保",
        common="抵押物的价值以双方确认的评估价值为准。",
        ok="抵押物评估价值为四千万元，担保债权本息合计不超过二千八百万元，抵押率不超过百分之七十，出借人可每年对抵押物价值重估一次。",
        bad="抵押物评估价值为四千万元，本合同项下担保债权本息合计五千万元，抵押率按百分之一百二十五执行，合同期内不对抵押物价值进行重估。",
    ),
    _rule(
        rule_id="R16", category="担保", risk_type="担保-最高额不明", level="高",
        title="最高额担保未约定最高债权额",
        scope=["最高额", "最高债权额", "担保范围"],
        keywords=["最高额", "最高额度", "债权额"],
        regex=r"最高额[^。]{0,30}(为准|不持异议)",
        llm_hint="判断最高额担保是否写明具体最高债权额及其构成",
        evidence=["最高债权额", "是否含利息费用", "超出部分处理"],
        suggestion="建议明确最高债权额及构成：所担保的最高债权额为人民币【】万元，包括本金、利息、罚息、复利、违约金及实现债权的费用，超出部分保证人不承担责任。",
        sug_keywords=["最高债权额", "超出部分"],
        problem="采用最高额担保却未约定具体最高债权额，以出借人核定的授信余额为准，担保范围随出借人内部核定浮动，保证人责任边界不确定，条款易被认定为约定不明。",
        section="担保",
        common="保证人同意在本合同约定的最高额担保范围内为借款人提供担保。",
        ok="本最高额担保所担保的最高债权额为人民币二千万元，包括本金、利息、罚息、复利及实现债权的费用。",
        bad="保证人在最高额度内为借款人提供担保，具体最高债权额以出借人核定的授信余额为准，保证人对此不持异议。",
    ),
    _rule(
        rule_id="R17", category="担保", risk_type="担保-质物交付不明", level="中",
        title="质物交付与保管责任不明",
        scope=["质押", "质物", "交付", "保管"],
        keywords=["质物", "交付", "保管"],
        regex=r"质物[^。]{0,24}(另行商定|自行保管)",
        llm_hint="判断质物的交付期限、交付方式与保管责任是否明确",
        evidence=["交付期限", "交付方式", "保管责任与风险承担"],
        suggestion="建议明确质物交付期限、交付方式与保管责任：出质人应于合同签订后 5 个工作日内交付权利凭证，保管期间毁损灭失风险由出质人承担，未经出借人同意不得处分质物。",
        sug_keywords=["交付", "保管"],
        problem="质物的交付时间与保管责任均被推给「另行商定」，在此之前质物仍由出质人自行占有使用，质权未有效设立，出借人对质物缺乏实际控制。",
        section="担保",
        common="出质人以其持有的应收账款为本合同项下债务提供质押担保。",
        ok="出质人应于本合同签订之日起五个工作日内将质物权利凭证交付出借人保管，保管期间质物毁损灭失的风险由出质人承担。",
        bad="质物的交付时间、交付方式及保管责任由双方另行商定，在另行商定前质物仍由出质人自行保管使用。",
    ),
    _rule(
        rule_id="R18", category="担保", risk_type="担保-配偶同意缺位", level="中",
        title="担保人配偶同意缺位",
        scope=["保证人", "配偶", "夫妻共同债务"],
        keywords=["配偶", "夫妻", "共同财产"],
        regex=r"(配偶|夫妻)[^。]{0,24}(同意|另行)",
        llm_hint="判断自然人担保人是否取得配偶书面同意，以覆盖夫妻共同财产",
        evidence=["配偶是否签署", "同意文件形式", "共同财产范围"],
        suggestion="建议要求保证人配偶签署同意担保的书面文件，并留存身份证明与签署过程记录，避免日后以夫妻共同债务范围为由抗辩。",
        sug_keywords=["配偶", "书面文件"],
        problem="以「配偶是否同意不影响合同效力」排除配偶同意环节，保证人一旦以夫妻共同财产范围提出抗辩，出借人对家庭共同财产的执行将遇阻。",
        section="担保",
        common="保证人应就其提供担保事宜取得配偶同意。",
        ok="保证人配偶应签署同意担保声明书，确认知悉并同意保证人以夫妻共同财产承担保证责任。",
        bad="保证人配偶是否同意本次担保不影响本合同效力，出借人无需另行取得配偶的书面同意文件。",
    ),
    _rule(
        rule_id="R19", category="担保", risk_type="担保-保证人资格瑕疵", level="高",
        title="保证人资格瑕疵（公益法人/国家机关）",
        scope=["保证人", "资格", "事业单位"],
        keywords=["事业单位", "财政", "保证人资格"],
        regex=r"(事业单位|国家机关|社会团体)[^。]{0,24}保证",
        llm_hint="判断保证人是否属于法律禁止担任保证人的主体（国家机关、公益性事业单位等）",
        evidence=["保证人主体性质", "是否营利法人", "代偿能力"],
        suggestion="建议更换保证人：以营利法人或具备代偿能力的自然人为保证人，并在签约前核验其主体资格与代偿能力，避免因保证人资格瑕疵导致保证合同无效。",
        sug_keywords=["营利法人", "代偿能力"],
        problem="保证人为财政全额拨款的事业单位，属于法律禁止提供保证的主体，保证合同存在被认定无效的风险，出借人将丧失该层担保。",
        section="担保",
        common="保证人应具备法律规定的保证人资格。",
        ok="保证人为依法设立并有效存续的企业法人，具备代为清偿债务的能力，且不属于法律禁止担任保证人的主体。",
        bad="保证人为示例市创新创业服务中心，系财政全额拨款事业单位，以其全部资产为借款人提供连带责任保证。",
    ),
    _rule(
        rule_id="R20", category="担保", risk_type="担保-自行处置担保物", level="高",
        title="约定排除司法程序自行处置担保物",
        scope=["担保物", "处置", "拍卖", "流质"],
        keywords=["自行变卖", "自行处置", "无需经人民法院"],
        regex=r"(自行变卖|自行处置)[^。]{0,24}抵押物",
        llm_hint="判断是否约定出借人可不经司法程序自行处置担保物、直接抵偿债务",
        evidence=["处置主体", "是否经司法程序", "通知义务", "价款结算方式"],
        suggestion="建议删除自行处置安排：主张担保物权应经协议折价、拍卖或变卖程序，协议不成时请求人民法院拍卖、变卖，处置所得按法定顺序清偿。",
        sug_keywords=["拍卖", "人民法院"],
        problem="约定出借人可自行变卖抵押物并直接抵偿、无需通知也无需司法拍卖，属于变相流质安排，条款存在无效风险，处置价款争议亦无救济渠道。",
        section="担保",
        common="债务履行期限届满未获清偿的，出借人有权依法实现担保物权。",
        ok="债务履行期限届满未获清偿的，出借人应与抵押人协议以抵押物折价或以拍卖、变卖所得价款优先受偿；协议不成的，可请求人民法院拍卖、变卖抵押物。",
        bad="借款人逾期超过十日的，出借人可自行变卖、处置抵押物并将所得价款直接抵偿债务，无需通知抵押人，亦无需经人民法院拍卖程序。",
    ),
    # ------------------------------------------------ 违约类 R21-R30
    _rule(
        rule_id="R21", category="违约", risk_type="违约-情形过宽", level="中",
        title="违约情形过宽（任何违反即可加速到期）",
        scope=["违约", "加速到期", "催告"],
        keywords=["任何违反", "均构成违约", "提前到期"],
        regex=r"违反本合同任何",
        llm_hint="判断是否将任何轻微违反一律列为违约并可宣布提前到期",
        evidence=["违约情形列举", "是否区分严重程度", "催告与宽限"],
        suggestion="建议限缩违约情形并设置催告程序：借款人发生约定情形且经书面催告后 10 个工作日内未纠正的，方构成违约。",
        sug_keywords=["催告", "纠正"],
        problem="将任何条款、承诺或附件的任何违反一律定为违约，并免除催告即可宣布提前到期，缺乏严重程度区分，轻微瑕疵即触发全部债务到期，条款显失公平。",
        section="违约责任",
        common="借款人发生下列情形之一的，构成违约。",
        ok="借款人发生下列情形之一，且经出借人书面催告后十个工作日内未予纠正的，构成违约。",
        bad="借款人违反本合同任何条款、任何承诺或任何附件的，均构成违约，出借人无需催告即可宣布借款提前到期。",
    ),
    _rule(
        rule_id="R22", category="违约", risk_type="违约-加速到期随意", level="中",
        title="加速到期条件纯单方随意",
        scope=["加速到期", "违约事件", "说明理由"],
        keywords=["随时宣布", "无需说明理由", "提前到期"],
        regex=r"(随时|认为)[^。]{0,24}宣布[^。]{0,12}提前到期",
        llm_hint="判断加速到期是否绑定具体违约事件并附说明理由义务",
        evidence=["触发条件", "是否需说明理由", "通知形式"],
        suggestion="建议将加速到期绑定具体违约事件并附说明理由义务：仅在约定违约事件发生且催告期届满未纠正时，出借人方可书面宣布提前到期并载明依据。",
        sug_keywords=["违约事件", "书面"],
        problem="加速到期仅以出借人「认为」有影响还款能力的情形为条件，无需说明理由且借款人不得异议，实质赋予单方随时收贷权，条款效力存疑。",
        section="违约责任",
        common="发生本合同约定的违约事件时，出借人有权宣布借款提前到期。",
        ok="发生本合同约定的违约事件且借款人未在催告期内纠正的，出借人有权书面宣布借款提前到期，并说明所依据的违约事实。",
        bad="出借人认为借款人有任何可能影响还款能力的情形时，可随时宣布借款提前到期，无需说明理由，借款人对该判断不持异议。",
    ),
    _rule(
        rule_id="R23", category="违约", risk_type="违约-违约金过高", level="高",
        title="违约金过高（超实际损失 30%）",
        scope=["违约金", "损失", "赔偿"],
        keywords=["违约金", "百分之三十", "本金"],
        regex=r"违约金[^。]{0,24}百分之(二十|三十|四十|五十)",
        llm_hint="判断违约金标准是否显著超过可证明的实际损失",
        evidence=["违约金比例", "计算基数", "与实际损失的关系"],
        suggestion="建议以实际损失为限：借款人违约的，应赔偿出借人因此产生的实际损失（含诉讼费、律师费、保全费），不再另行约定按本金比例计算的违约金。",
        sug_keywords=["实际损失", "诉讼费"],
        problem="违约金按借款本金 30% 计收，且不影响另主张罚息与损害赔偿，明显超过资金占用损失，超出部分在诉讼中大概率被调减，条款可执行性不足。",
        section="违约责任",
        common="借款人违反本合同约定的，应向出借人支付违约金。",
        ok="借款人构成违约的，应赔偿出借人因此产生的实际损失，包括但不限于诉讼费、律师费、保全费及差旅费。",
        bad="借款人构成违约的，应按借款本金的百分之三十向出借人支付违约金，且不影响出借人另行主张罚息与损害赔偿。",
    ),
    _rule(
        rule_id="R24", category="违约", risk_type="违约-违约金重复计算", level="中",
        title="违约金与罚息重复计算",
        scope=["违约金", "罚息", "重复计收"],
        keywords=["并行计算", "互不抵扣", "违约金"],
        regex=r"罚息[^。]{0,40}违约金[^。]{0,24}(并行|同时)",
        llm_hint="判断是否在罚息之外并行计收违约金，构成重复计收",
        evidence=["罚息标准", "违约金标准", "是否重复计收"],
        suggestion="建议删除并行计收安排：逾期后仅按罚息利率计收罚息，违约金与罚息不重复计算，避免被认定为变相提高利率。",
        sug_keywords=["不重复", "罚息"],
        problem="逾期后同时按罚息利率计息并按日万分之五计收违约金且互不抵扣，两项均指向同一资金占用损失，重复计收部分难以获得支持，亦可能被整体认定为变相高息。",
        section="违约责任",
        common="借款人逾期的，出借人有权主张逾期责任。",
        ok="借款人逾期的，出借人有权按罚息利率计收罚息；罚息已覆盖资金占用损失的，不再重复计收违约金。",
        bad="借款人逾期的，出借人有权在按罚息利率计收罚息的同时，按逾期本金的每日万分之五计收违约金，两项并行计算且互不抵扣。",
    ),
    _rule(
        rule_id="R25", category="违约", risk_type="违约-无宽限期", level="低",
        title="未约定宽限期与催告程序",
        scope=["宽限期", "催告", "逾期"],
        keywords=["宽限期", "催告", "次日"],
        regex=r"(不设宽限期|无宽限期|无需催告)",
        llm_hint="判断逾期后是否设置合理宽限期与催告程序",
        evidence=["宽限期长度", "催告方式", "后果承担"],
        suggestion="建议设置合理宽限期与催告程序：还款日后 5 个工作日内经催告补足的，不视为违约，宽限期内按罚息利率计收利息。",
        sug_keywords=["宽限期", "催告"],
        problem="还款日次日即构成违约，不设宽限期与催告程序，未考虑银行清算在途等客观因素，借款人因技术性逾期即被计收罚息并影响征信，争议概率高。",
        section="违约责任",
        common="借款人未按期还款的，应承担违约责任。",
        ok="借款人未在还款日足额还款的，出借人应于次日发出书面催告，借款人自催告送达之日起五个工作日内补足的，不视为违约。",
        bad="借款人未在还款日足额还款的，自还款日次日起即构成违约，出借人可直接采取措施，不设宽限期与催告程序。",
    ),
    _rule(
        rule_id="R26", category="违约", risk_type="违约-交叉违约无限定", level="中",
        title="交叉违约未限定范围",
        scope=["交叉违约", "其他债务", "金额门槛"],
        keywords=["交叉违约", "任何第三方", "任何债务"],
        regex=r"任何第三方[^。]{0,24}任何债务",
        llm_hint="判断交叉违约是否设定金额门槛、债务类型与主体范围",
        evidence=["触发金额门槛", "债务类型范围", "是否需进入诉讼"],
        suggestion="建议为交叉违约设定金额门槛与范围：借款人对其他金融机构的债务逾期且单笔金额超过 100 万元的，方构成违约事件。",
        sug_keywords=["金额", "逾期"],
        problem="将借款人与任何第三方的任何债务争议均列为违约事件，不论金额大小与是否进入诉讼，触发面过宽，正常商业纠纷即可导致本合同项下债务被宣布到期。",
        section="违约责任",
        common="借款人涉及其他债务纠纷的，应于三个工作日内书面告知出借人。",
        ok="借款人对其他金融机构的债务发生逾期且单笔金额超过人民币一百万元的，构成本合同项下的违约事件。",
        bad="借款人与任何第三方的任何债务发生争议、逾期或被主张权利的，均构成本合同项下的违约事件，无论金额大小及是否已进入诉讼程序。",
    ),
    _rule(
        rule_id="R27", category="违约", risk_type="违约-实现债权费用缺失", level="低",
        title="未约定实现债权费用承担",
        scope=["实现债权费用", "律师费", "诉讼费"],
        keywords=["实现债权", "律师费", "自行承担"],
        regex=r"实现债权[^。]{0,24}自行承担",
        llm_hint="判断是否约定诉讼费、律师费、保全费等实现债权费用由借款人承担",
        evidence=["费用项目", "承担主体", "凭证要求"],
        suggestion="建议补充实现债权费用条款：因实现债权支出的诉讼费、律师费、保全费、公证费、差旅费由借款人承担。",
        sug_keywords=["律师费", "诉讼费"],
        problem="约定实现债权的费用由出借人自行承担，出借人追索成本无法转嫁，在借款人违约情形下实际回收率下降，属对出借人不利的责任分配。",
        section="违约责任",
        common="借款人应承担本合同项下应由其承担的各项费用。",
        ok="出借人因实现债权支出的诉讼费、律师费、保全费、公证费及差旅费由借款人承担。",
        bad="出借人实现债权所支出的费用由出借人自行承担，借款人仅承担合同约定的利息与本金。",
    ),
    _rule(
        rule_id="R28", category="违约", risk_type="违约-陈述保证过重", level="低",
        title="陈述保证义务过重且无救济",
        scope=["陈述与保证", "资料真实性", "违约"],
        keywords=["任何时点", "任何瑕疵", "陈述保证"],
        regex=r"任何时点均真实[^。]{0,24}任何瑕疵",
        llm_hint="判断陈述保证是否要求绝对无瑕疵、且任何细微不符即构成违约",
        evidence=["保证标准", "重大性门槛", "救济与纠正期"],
        suggestion="建议将陈述保证限定于重大性标准：借款人保证资料在提供之日真实、准确、完整，发生重大变化时及时告知，非重大瑕疵不构成违约。",
        sug_keywords=["重大", "告知"],
        problem="要求资料在任何时点绝对真实完整且无任何瑕疵，任何细微不符即构成违约并承担全部责任，标准过于绝对且无纠正机会，实践中难以执行。",
        section="违约责任",
        common="借款人向出借人作出如下陈述与保证。",
        ok="借款人保证其提交的资料在提供之日真实、准确、完整；资料发生重大变化的，应于十个工作日内书面告知出借人。",
        bad="借款人保证其提交的全部资料在任何时点均真实、准确、完整且不存在任何瑕疵，如日后发现任何细微不符，即构成违约并应承担全部责任。",
    ),
    _rule(
        rule_id="R29", category="违约", risk_type="违约-不可抗力缺失", level="低",
        title="未约定不可抗力与情势变更处理",
        scope=["不可抗力", "情势变更", "免责"],
        keywords=["不可抗力", "情势变更", "免责"],
        regex=r"不发生任何不可抗力",
        llm_hint="判断是否排除不可抗力/情势变更的适用，或完全未作约定",
        evidence=["不可抗力条款", "通知与证明", "后果处理"],
        suggestion="建议补充不可抗力与情势变更条款：受影响方应在事件发生后 15 日内提供证明，双方协商调整还款安排，互不承担违约责任。",
        sug_keywords=["不可抗力", "协商"],
        problem="以约定方式排除不可抗力与情势变更的适用，与法律关于不可抗力免责的规定相冲突，该排除条款难以获得支持，反而使合同缺乏应对突发事件的调整机制。",
        section="违约责任",
        common="因不可抗力致使合同无法履行的，双方按下列约定处理。",
        ok="因不可抗力致使合同全部或部分不能履行的，受影响方应在事件发生后十五日内提供证明，双方协商调整还款安排，互不承担违约责任。",
        bad="本合同履行过程中不发生任何不可抗力或情势变更情形，借款人不得以此为由主张减免责任或调整还款安排。",
    ),
    _rule(
        rule_id="R30", category="违约", risk_type="违约-单方变更", level="高",
        title="出借人可单方变更合同条款",
        scope=["变更", "单方", "公告"],
        keywords=["单方变更", "公告之日起生效", "视为同意"],
        regex=r"(单方变更|单方调整)[^。]{0,12}(条款|合同)",
        llm_hint="判断是否赋予出借人单方变更合同条款的权利，以公告或继续履行视为同意",
        evidence=["变更权主体", "生效方式", "借款人同意形式"],
        suggestion="建议删除单方变更权：合同变更须经双方协商一致并签署书面补充协议，未经借款人书面同意的变更对其不发生效力。",
        sug_keywords=["协商一致", "书面"],
        problem="赋予出借人单方变更合同条款的权利，并以网站公告加继续履行视为同意，借款人无从协商亦难以拒绝，属典型加重对方责任、排除对方主要权利的格式条款。",
        section="违约责任",
        common="本合同的变更应经双方协商一致。",
        ok="本合同的任何变更应经双方协商一致并签署书面补充协议；未经借款人书面同意的变更对借款人不发生效力。",
        bad="出借人有权根据监管要求或内部管理需要单方变更本合同条款，变更内容自出借人网站公告之日起生效，借款人继续履行即视为同意。",
    ),
    # ------------------------------------------------ 合规类 R31-R40
    _rule(
        rule_id="R31", category="合规", risk_type="合规-格式条款提示", level="高",
        title="格式条款未履行提示说明义务",
        scope=["格式条款", "提示", "说明义务"],
        keywords=["格式条款", "加粗", "逐条确认"],
        regex=r"相同字号与字重|无需逐条确认",
        llm_hint="判断免责/加重责任/限制权利条款是否以显著方式提示并单独确认",
        evidence=["提示方式", "是否单独确认", "留痕记录"],
        suggestion="建议对免责、加重责任、限制权利的条款采用加粗或下划线等显著方式提示，并设置借款人逐条签字确认栏，留存提示说明记录。",
        sug_keywords=["加粗", "确认"],
        problem="免除出借人责任、加重借款人责任的条款与其他条款同字号同字重排布，仅统一签章而无需逐条确认，未履行提示与说明义务，相关条款可能不成为合同内容。",
        section="其他约定",
        common="本合同采用出借人提供的格式文本订立。",
        ok="本合同中免除或减轻出借人责任、加重借款人责任、限制借款人主要权利的条款以加粗字体标示，借款人已逐条阅读并签字确认。",
        bad="本合同中免除出借人责任、加重借款人责任的条款与其他条款采用相同字号与字重排布，借款人仅在合同末尾统一签章，无需逐条确认。",
    ),
    _rule(
        rule_id="R32", category="合规", risk_type="合规-无效格式条款", level="高",
        title="排除借款人主要权利、加重其责任",
        scope=["格式条款", "无效", "异议权"],
        keywords=["放弃", "异议", "抗辩"],
        regex=r"放弃[^。]{0,24}(异议|抗辩|诉讼)",
        llm_hint="判断是否排除借款人的异议权、抗辩权、诉权等主要权利",
        evidence=["被排除的权利", "是否对等", "无效风险"],
        suggestion="建议删除排除借款人异议权、抗辩权与诉权的表述：出借人行使权利应书面通知并说明依据，借款人有权提出异议并依法寻求救济。",
        sug_keywords=["异议", "救济"],
        problem="要求借款人放弃全部异议、抗辩与诉讼权利，并自行承担一切后果，属于排除对方主要权利、加重对方责任的格式条款，依法可能被认定为无效。",
        section="其他约定",
        common="双方就本合同项下权利义务的分配约定如下。",
        ok="出借人依本合同约定行使权利时，应书面通知借款人并说明依据；借款人对出借人主张有异议的，有权提出异议并依法寻求救济。",
        bad="出借人有权随时宣布借款到期并处置担保物，借款人放弃就本合同提出任何异议、抗辩及诉讼的权利，由此产生的一切后果由借款人自行承担。",
    ),
    _rule(
        rule_id="R33", category="合规", risk_type="合规-争议解决不明", level="中",
        title="争议解决约定不明（诉讼与仲裁并存）",
        scope=["争议解决", "仲裁", "诉讼"],
        keywords=["仲裁", "诉讼", "二者"],
        regex=r"提起诉讼[^。]{0,30}(也可|或)[^。]{0,12}仲裁",
        llm_hint="判断是否同时约定诉讼与仲裁，或仲裁机构名称不明确",
        evidence=["争议解决方式", "机构名称", "是否唯一"],
        suggestion="建议二选一并明确机构：因本合同发生的争议协商不成的，向出借人所在地有管辖权的人民法院提起诉讼（或明确唯一的仲裁委员会名称）。",
        sug_keywords=["人民法院", "唯一"],
        problem="同时约定诉讼与仲裁并交由出借人选择，争议解决方式不确定，可能导致仲裁条款无效并引发管辖权异议，延长纠纷处理周期。",
        section="争议解决",
        common="因本合同发生的争议，双方按下列方式解决。",
        ok="因本合同发生的争议，双方应协商解决；协商不成的，向出借人所在地有管辖权的人民法院提起诉讼。",
        bad="因本合同发生的争议，双方可向有管辖权的人民法院提起诉讼，也可提交仲裁机构仲裁，由出借人选择其中一种方式。",
    ),
    _rule(
        rule_id="R34", category="合规", risk_type="合规-管辖无连接点", level="中",
        title="管辖约定与法定连接点无关",
        scope=["管辖", "连接点", "法院"],
        keywords=["管辖", "关联公司", "住所地"],
        regex=r"管辖[^。]{0,30}(无关联|均无)",
        llm_hint="判断约定管辖法院是否与争议有实际联系（被告住所地、合同履行地、签订地、标的物所在地等）",
        evidence=["约定法院", "与争议的连接点", "是否有效"],
        suggestion="建议将管辖法院约定在与争议有实际联系的地点，例如合同签订地、履行地或出借人住所地人民法院。",
        sug_keywords=["实际联系", "住所地"],
        problem="约定由与合同签订地、履行地及双方住所地均无关的关联公司注册地法院管辖，缺乏法定连接点，管辖协议存在被认定无效的风险。",
        section="争议解决",
        common="双方就争议管辖法院作出约定。",
        ok="因本合同发生的争议，由合同签订地或出借人住所地有管辖权的人民法院管辖。",
        bad="因本合同发生的争议，双方一致同意由出借人关联公司注册地人民法院管辖，该地与合同签订地、履行地及双方住所地均无关联。",
    ),
    _rule(
        rule_id="R35", category="合规", risk_type="合规-送达条款缺失", level="低",
        title="通知送达未约定地址变更与视为送达",
        scope=["送达", "通知", "地址变更"],
        keywords=["送达", "地址", "视为"],
        regex=r"(视为已送达)[^。]{0,24}(无需|变更)?",
        llm_hint="判断是否约定有效送达地址、变更通知义务与视为送达情形",
        evidence=["送达地址确认", "变更通知义务", "视为送达情形"],
        suggestion="建议补充送达条款：确认首部地址为有效送达地址，变更应于 5 个工作日内书面通知，未通知的按原地址送达视为有效；并约定拒收、退回亦视为送达。",
        sug_keywords=["送达", "工作日"],
        problem="仅以系统推送作为通知方式并将未查看视为送达，同时免除借款人地址变更的告知义务，送达链条不完整，诉讼阶段易因送达瑕疵影响程序推进。",
        section="通知与送达",
        common="双方就通知与送达事宜作出约定。",
        ok="双方确认合同首部载明的地址、电子邮箱与手机号码为有效送达地址；一方变更送达地址的，应于变更之日起五个工作日内书面通知对方，未通知的，按原地址送达即视为有效送达。",
        bad="本合同项下的通知以出借人系统内推送为准，借款人未及时查看的视为已送达；借款人地址变更无需告知出借人。",
    ),
    _rule(
        rule_id="R36", category="合规", risk_type="合规-个人信息", level="高",
        title="个人信息处理未单独同意/未告知目的",
        scope=["个人信息", "同意", "第三方提供"],
        keywords=["个人信息", "单独同意", "第三方"],
        regex=r"无需另行取得[^。]{0,12}同意",
        llm_hint="判断个人信息处理是否取得单独同意、是否告知目的与范围、是否限制第三方共享",
        evidence=["处理目的告知", "同意形式", "第三方共享限制"],
        suggestion="建议补充个人信息处理条款：处理目的、方式与范围应明确告知并取得单独同意；未经单独同意不得向第三方提供；借款人有权查询、更正与撤回同意。",
        sug_keywords=["单独同意", "第三方"],
        problem="约定出借人可收集、使用个人信息并向合作第三方提供，无需单独同意亦无需告知目的与范围，不符合个人信息处理的最小必要与告知同意要求。",
        section="个人信息与保密",
        common="借款人同意出借人依法处理其个人信息。",
        ok="出借人处理借款人个人信息应遵循合法、正当、必要原则，并取得借款人的单独同意；未经单独同意不得向第三方提供，法律法规另有规定的除外。",
        bad="出借人有权为业务需要收集、使用借款人个人信息并向合作的第三方机构提供，无需另行取得借款人同意，也无需告知处理目的与范围。",
    ),
    _rule(
        rule_id="R37", category="合规", risk_type="合规-数据出境", level="中",
        title="未约定数据出境与第三方共享限制",
        scope=["数据出境", "第三方共享", "数据安全"],
        keywords=["境外", "传输", "关联机构"],
        regex=r"境外[^。]{0,24}(传输|提供)",
        llm_hint="判断是否约定数据本地化、数据出境限制与第三方共享范围",
        evidence=["是否允许出境", "审批与同意程序", "共享范围限制"],
        suggestion="建议明确数据本地化与出境限制：不得向境外提供借款人信息；确需出境的，应履行法定程序并取得单独同意，同时约定第三方共享的范围与限制。",
        sug_keywords=["不得", "单独同意"],
        problem="约定可将借款人信息传输至境外关联机构且范围与接收方由出借人单方确定、无需告知，未履行数据出境的安全评估与单独同意程序，合规风险突出。",
        section="个人信息与保密",
        common="本合同项下数据的存储与使用应遵守数据安全相关法律。",
        ok="出借人不得将借款人信息传输至境外；确需向境外提供的，应履行法定程序并取得借款人单独同意。",
        bad="出借人可将借款人信息传输至境外关联机构用于风险管理，传输范围与接收方由出借人确定，无需另行告知借款人。",
    ),
    _rule(
        rule_id="R38", category="合规", risk_type="合规-电子签名效力", level="低",
        title="电子签名/电子合同效力条款缺失",
        scope=["电子签名", "电子合同", "效力"],
        keywords=["电子签名", "电子合同", "存证"],
        regex=r"电子签名[^。]{0,24}(以.{0,8}系统记录为准)",
        llm_hint="判断电子签名效力、合同文本交付与存证安排是否约定",
        evidence=["电子签名可靠性", "合同文本交付", "存证与时间戳"],
        suggestion="建议补充电子签名与电子合同效力条款：采用可靠电子签名，与书面形式具有同等效力；向借款人提供可下载的合同文本与签署存证记录。",
        sug_keywords=["可靠电子签名", "存证"],
        problem="电子形式签约的效力仅以出借人系统记录为准，未约定可靠电子签名标准，也未约定向借款人交付合同文本，借款人难以留存证据，签署效力存在争议。",
        section="其他约定",
        common="本合同可采用电子形式订立。",
        ok="本合同采用可靠电子签名订立的，与书面形式具有同等法律效力；出借人应向借款人提供可查阅、可下载的合同文本及签署时间戳记录。",
        bad="本合同以电子形式签署时，电子签名的效力以出借人系统记录为准，借款人不得以未收到合同文本为由否认合同成立。",
    ),
    _rule(
        rule_id="R39", category="合规", risk_type="合规-综合成本未披露", level="中",
        title="未按年化披露综合融资成本",
        scope=["综合融资成本", "年化", "披露"],
        keywords=["综合融资成本", "年化", "披露"],
        regex=r"(仅披露|不在披露范围)",
        llm_hint="判断是否以年化形式披露包含费用的综合融资成本",
        evidence=["披露口径", "费用项目", "年化折算结果"],
        suggestion="建议按年化口径披露综合融资成本：列明利息、管理费、担保费、评估费等全部费用项目及折算后的年化成本，避免隐性成本。",
        sug_keywords=["年化", "全部费用"],
        problem="仅披露执行利率，账户管理费、担保费、评估费等被明确排除在披露范围外，借款人无法知悉真实融资成本，与综合成本年化披露的监管要求不符。",
        section="其他约定",
        common="出借人应向借款人披露本合同项下的融资成本。",
        ok="出借人应以年化形式向借款人披露综合融资成本，包括利息及各项费用，并在合同中列明费用项目、金额与收取方式。",
        bad="本合同仅披露执行利率，账户管理费、担保费、评估费等其他费用不在披露范围内，借款人应按实际发生金额支付。",
    ),
    _rule(
        rule_id="R40", category="合规", risk_type="合规-解除后清算缺失", level="低",
        title="未约定合同解除后的清算顺序",
        scope=["解除", "清算顺序", "费用退还"],
        keywords=["解除", "清算", "顺序"],
        regex=r"清算顺序[^。]{0,24}单方确定",
        llm_hint="判断合同解除后本金、利息、费用的清算顺序与已收费用的处理是否明确",
        evidence=["清算顺序", "费用是否退还", "清偿期限"],
        suggestion="建议补充解除后的清算顺序：依次清偿实现债权费用、利息、本金，已收费用按实际用款期限结算并退还多收部分。",
        sug_keywords=["清算顺序", "退还"],
        problem="合同解除后已收费用不退、未到期利息仍按全期计算，且清算顺序由出借人单方确定，借款人对解除后果缺乏可预期性，易产生争议。",
        section="其他约定",
        common="本合同解除后，双方应按下列约定处理后续事宜。",
        ok="本合同解除后，借款人应立即清偿未还本金及自起息日至清偿日的利息；已收取的费用按实际用款期限结算，多收部分予以退还，清偿顺序依次为实现债权费用、利息、本金。",
        bad="本合同解除后，已收取的费用不予退还，未到期利息仍按合同期限计算，借款人应在解除之日起三日内清偿全部款项，清算顺序由出借人单方确定。",
    ),
]

RULE_BY_ID = {r["rule_id"]: r for r in RULES}
RULE_BY_TYPE = {r["risk_type"]: r for r in RULES}

LEVEL_OF_RULE = {r["rule_id"]: r["level"] for r in RULES}

# ---------------------------------------------------------------- 基础条款片段库
# 每条片段 = head + 抽样若干 items + （可选）tail。
# section 即条款的类型标签；requires 表示仅在该担保方式下启用。

SECTION_ORDER = [
    "定义与解释", "借款金额与用途", "利率与计息", "放款条件", "还款", "提前还款",
    "担保", "陈述与保证", "违约责任", "争议解决", "通知与送达",
    "个人信息与保密", "其他约定",
]


def _cl(key, section, head, items, min_items=2, requires=None, tail=""):
    return {"key": key, "section": section, "head": head, "items": list(items),
            "min_items": min_items, "requires": requires, "tail": tail}


