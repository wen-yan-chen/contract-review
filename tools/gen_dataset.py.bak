# ---------------------------------------------------------------- 输出

def dump_json(path: Path, obj) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def build_rules_yaml() -> list[dict]:
    out = []
    for r in RULES:
        out.append({
            "rule_id": r["rule_id"],
            "category": r["category"],
            "title": r["title"],
            "risk_type": r["risk_type"],
            "risk_level": r["level"],
            "scope": r["scope"],
            "detect": {
                "method": "hybrid",
                "keywords": r["keywords"],
                "regex": r["regex"],
                "llm_hint": r["llm_hint"],
            },
            "evidence_spec": r["evidence"],
            "suggestion_template": r["suggestion"],
            "suggestion_keywords": r["sug_keywords"],
            "legal_basis": {"name": "待核验", "article": "待核验", "url": "",
                            "verify_status": "pending"},
            "disabled": False,
        })
    return out


def build_readme(stats: dict) -> str:
    lines: list[str] = []
    a = lines.append
    a("# 贷款合同审查 · 评测数据集")
    a("")
    a(f"> 生成器：`tools/gen_dataset.py`（{DATASET_VERSION}）｜seed={stats['seed']}｜"
      f"全部内容由脚本确定性生成，可重复复现。")
    a("")
    a("## 0. 一句话说明")
    a("")
    a("本目录是为课题 #32「贷款合同审查」构建的**评测数据集**：20 份虚构贷款合同 + 逐条标注的"
      "风险清单 + 40 条规则库 + 11 组边界样本 + 1 份授信批复（含 3 处不一致）。"
      "标注用于计算检出率、误报率、定位准确率、等级一致率等验收指标。")
    a("")
    a(f"**核心数字**：{len(CONTRACTS)} 份合同 / {stats['totals']['n']} 条条款 / "
      f"{stats['totals']['chars']:,} 字 / **{stats['totals']['total']} 条标注**"
      f"（后续所有指标的分母）/ 40 条规则全覆盖 / {stats['files']} 个生成文件。")
    a("")
    a("**数据来源声明**：全部合同、企业名称、个人姓名、编号、地址、金额、账号均为脚本生成的虚构占位，"
      "不含任何真实企业、真实个人或真实合同内容；企业名称统一带「（模拟）」标记，人名统一为「某」字占位。"
      "法规依据一律写 `待核验` / `pending`，**未编造任何法规名称、条号或文号**。")
    a("")
    a("## 1. 目录结构")
    a("")
    a("```")
    a("data/")
    a("├── samples/                      20 份合同 + 边界样本 + 授信批复")
    a("│   ├── C01..C20_*.docx")
    a("│   ├── boundary/B01..B11_*.docx  11 组边界样本")
    a("│   └── credit_report_C03.json    授信批复（3 处不一致）")
    a("├── clauses/C01..C20.json         条款表 [{clause_id, clause_no, text}]")
    a("├── labels/C01..C20.json          标注（每条风险 12 个字段）")
    a("├── labels/split.json             dev / holdout / clean 划分")
    a("├── labels/type_map.yaml          风险类型归一化映射")
    a("├── rules/rules.yaml              40 条规则（四类各 10 条）")
    a("└── README.md")
    a("```")
    a("")
    a("## 2. 20 份合同总览")
    a("")
    a("| 合同 | 行业/客户 | 金额 | 担保 | 分组 | 条款数 | 字数 | 植入(bad) | 合规(ok) | 高 | 中 | 低 |")
    a("|---|---|---|---|---|---:|---:|---:|---:|---:|---:|---:|")
    for row in stats["contract_rows"]:
        a("| {cid} | {client} | {amount} | {guarantee} | {split} | {n} | {chars} | {total} "
          "| {ok} | {high} | {mid} | {low} |".format(**row))
    a("| **合计** | — | — | — | — | **{n}** | **{chars}** | **{total}** | **{ok}** | **{high}** | "
      "**{mid}** | **{low}** |".format(**stats["totals"]))
    a("")
    a("字段口径：")
    a("")
    a("- **条款数**：按「第X条」连续编号，`clause_id = {contract_id}-{序号:03d}`"
      "（序号从 001 起，按出现顺序，不用内容 hash）")
    a("- **字数**：该合同全部条款正文的字符数（含条款号，不含首部与签署页）")
    a("- **植入(bad)**：标注的 `risks` 条数，即该合同的问题表述条款数")
    a("- **合规(ok)**：同一合同内**合规表述**的规则条款数；`bad + ok` 恒等于 40")
    a("- 条款编号严格连续、无跳号、无重复；每份 90~110 条、10000~14000 字")
    a("")
    a("## 2.1 40 条规则的覆盖方式（本版重点）")
    a("")
    a("**每一份合同都包含全部 40 条规则的条款，一条不缺。** 对每条规则，合同中要么是")
    a("**问题表述（bad，= 植入的风险，进标注）**，要么是**合规表述（ok，= 合规对照，不入标注）**：")
    a("")
    a("| 合同类型 | bad 条数 | ok 条数 | 合计 |")
    a("|---|---:|---:|---:|")
    a("| 非 clean（16 份） | 3–8 | 32–37 | 40 |")
    a("| clean（4 份） | 0 | 40 | 40 |")
    a("")
    a("设计动因：pilot 阶段模型如实报告「本合同未约定抵押登记 / 未约定送达」，")
    a("但旧版合同里确实没有这些条款，正确判断被算成误报（误报率 48.9%）。")
    a("本版把 40 条规则全部落成条款，模型无论报或不报都有原文可依，")
    a("误报只能来自「把 ok 条款判成风险」或「凭空捏造」，这才测的是模型能力。")
    a("")
    a("验收方式：`python tools/check_coverage.py` 用精确子串匹配确认每份合同的 40 条规则")
    a("都能在正文中找到 ok 或 bad，输出「合计「无对应条款」0 处」。")
    a("")
    a("## 3. dev / holdout / clean 划分")
    a("")
    a("| 分组 | 数量 | 合同 | 用途 |")
    a("|---|---:|---|---|")
    a(f"| dev | {len(stats['split']['dev'])} | {', '.join(stats['split']['dev'])} | 日常调参、规则迭代 |")
    a(f"| holdout | {len(stats['split']['holdout'])} | {', '.join(stats['split']['holdout'])} | 锁死，只跑一次 |")
    a(f"| clean | {len(stats['split']['clean'])} | {', '.join(stats['split']['clean'])} | "
      "零中高风险，专压误报率 |")
    a("")
    a("**三组关系**：`clean ⊂ dev`。4 份 clean 合同本身就在 dev 的 12 份之内，"
      "因此 dev(12) + holdout(8) = 20 份，clean 是 dev 的子集标签而非第四组。"
      "clean 合同**不植入任何风险**（0 条标注），但保留了若干"
      "「看着像风险、实际合规」的干扰条款（见各标注的 `distractor_clause_ids`），"
      "系统在这 4 份上输出的任何风险都计为误报。")
    a("")
    a("`split.json` 只含 `dev` / `holdout` / `clean` 三个键，不含其他字段。")
    a("")
    a("## 4. 标注格式")
    a("")
    a("`labels/{contract_id}.json` 顶层字段：")
    a("")
    a("| 字段 | 说明 |")
    a("|---|---|")
    a("| `contract_id` | 合同编号，如 C03 |")
    a("| `file` | 对应 docx 相对路径 |")
    a("| `perspective` | 固定 `lender`，以出借人（金融机构）合规与风险视角判定 |")
    a("| `parser_version` | 切分版本，固定 `split-v1` |")
    a("| `clauses_total` / `char_total` | 条款数与字数 |")
    a("| `risk_summary` | 高/中/低 计数 |")
    a("| `source_credit_report` | 需要比对授信的合同才有值，其余为 null |")
    a("| `distractor_clause_ids` | 合规表述（ok）条款 ID，共 40 − bad 条；这些条款**不应**报为风险 |")
    a("| `risks` | 风险数组，每条 12 个字段 |")
    a("| `consistency_checks` | 授信比对结果，无则空数组 |")
    a("")
    a("每条风险固定 12 个字段：")
    a("")
    a("```json")
    a('{"risk_id", "clause_id", "clause_no", "risk_type", "rule_id", "risk_level",')
    a(' "char_start", "char_end", "quote", "problem", "suggestion", "legal_basis"}')
    a("```")
    a("")
    a("- `char_start` / `char_end`：相对**该条款正文**（`clauses/{cid}.json` 的 `text`）的字符偏移，"
      "0-based、左闭右开，`text[start:end]` 必须严格等于 `quote`")
    a("- `quote`：不含「第X条」，且在该条款正文中**恰好出现一次**（程序校验）")
    a("- `risk_level`：只有 `高` / `中` / `低`")
    a("- `rule_id`：必须是 `rules.yaml` 中真实存在的 R01–R40")
    a("- `legal_basis`：一律为 `{\"name\": \"待核验\", \"verify_status\": \"pending\", \"url\": \"\"}`，"
      "**未经人工核验不填法规名称与文号**")
    a("")
    a("## 5. 规则库（40 条，四类各 10 条）")
    a("")
    a("| 类别 | 规则区间 | 条数 | 高 | 中 | 低 |")
    a("|---|---|---:|---:|---:|---:|")
    for cat in ("利率", "担保", "违约", "合规"):
        rs = [r for r in RULES if r["category"] == cat]
        a(f"| {cat} | {rs[0]['rule_id']}–{rs[-1]['rule_id']} | {len(rs)} | "
          f"{sum(1 for r in rs if r['level'] == '高')} | "
          f"{sum(1 for r in rs if r['level'] == '中')} | "
          f"{sum(1 for r in rs if r['level'] == '低')} |")
    a(f"| **合计** | R01–R40 | **40** | "
      f"**{sum(1 for r in RULES if r['level'] == '高')}** | "
      f"**{sum(1 for r in RULES if r['level'] == '中')}** | "
      f"**{sum(1 for r in RULES if r['level'] == '低')}** |")
    a("")
    a("每条规则包含：`rule_id` / `category` / `title` / `risk_type` / `risk_level` / `scope` / "
      "`detect{method,keywords,regex,llm_hint}` / `evidence_spec` / `suggestion_template` / "
      "`suggestion_keywords` / `legal_basis` / `disabled`。")
    a("")
    a("### 5.1 规则覆盖情况（规则 → 植入到哪些合同）")
    a("")
    a("| 规则 | 风险类型 | 等级 | 植入合同 | 次数 |")
    a("|---|---|---|---|---:|")
    for r in RULES:
        cids = stats["coverage"].get(r["rule_id"], [])
        a(f"| {r['rule_id']} | {r['risk_type']} | {r['level']} | {', '.join(cids)} | {len(cids)} |")
    a("")
    a(f"**覆盖率：{stats['covered']}/40 = 100%**，每条规则至少被植入一次。")
    a("")
    a("## 6. 授信批复与 3 处不一致")
    a("")
    a("`samples/credit_report_C03.json` 为模拟授信批复，`inconsistencies` 字段内置 3 处不一致，"
      "`comparison_basis` 给出各合同的批复值，供后端做确定性比对（字符串可解析，不靠模型）：")
    a("")
    a("| 检查项 | 合同 | 合同值 | 授信值 | 等级 |")
    a("|---|---|---|---|---|")
    for it in CREDIT_REPORT["inconsistencies"]:
        a(f"| {it['field']} | {it['contract_id']} | {it['contract_value']} | "
          f"{it['credit_report_value']} | {it['level']} |")
    a("")
    a("对应标注文件中的 `consistency_checks` 记录同样的三处差异（C03/C04/C05）。")
    a("")
    a("## 7. 边界样本（11 组）")
    a("")
    a("| 编号 | 特征 | 考察点 | 文件 |")
    a("|---|---|---|---|")
    for bid, feat, point in BOUNDARY_NOTE:
        fname = next(f for f, _ in BOUNDARY_WRITERS if f.startswith(bid))
        a(f"| {bid} | {feat} | {point} | `boundary/{fname}` |")
    a("")
    a("说明：")
    a("")
    a("- 全部边界样本为 docx。B05「双栏排版」用 Word 双栏节（`w:cols num=2`）模拟双栏 PDF 排版，"
      "B04「纯图片扫描件」为内嵌 PNG、无文字层，其余样本均带真实文字层。")
    a("- 边界样本**不提供标注**（`labels/` 只覆盖 C01–C20），其作用是检验解析与切分鲁棒性，"
      "预期行为见上表「考察点」列。")
    a("")
    a("## 8. 复现与校验")
    a("")
    a("```powershell")
    a("$py = \"D:\\python\\python3.13.5\\python.exe\"")
    a("")
    a("# 重新生成全部数据（同 seed 结果逐字节一致）")
    a("& $py tools/gen_dataset.py --out data --seed 42")
    a("")
    a("# 标注自检：必须输出「通过 ✅」")
    a("& $py tools/validate_labels.py --data-root data")
    a("```")
    a("")
    a("### 8.1 确定性")
    a("")
    a("生成器不使用系统时间、不依赖 `PYTHONHASHSEED`、不迭代无序集合；所有随机流由 "
      "`random.Random(f\"{seed}:{salt}\")` 派生，因此与调用顺序无关。"
      "docx 保存后统一重写 zip 条目时间戳与文档属性，消除保存时刻带来的字节差异。"
      f"**同一 seed 两次运行，全部 {stats['files']} 个文件逐字节一致**（见交付回报中的 diff 结果）。")
    a("")
    a("## 9. 已知限制")
    a("")
    a("1. `legal_basis` 全部为 `pending`。这是刻意的：法规名称、条号、文号必须由人工对照真实文件核验后填写，"
      "脚本不生成任何法规内容，以免出现编造（验收红线：出现 1 处编造即该项不合格）。")
    a("2. `problem` / `suggestion` 由规则模板生成，同一规则在不同合同中的措辞相同，"
      "这是评测集的一致性优点，但用于演示时建议人工润色个别措辞。")
    a(f"3. 合同主体结构同源（同一套 {len(CLAUSE_POOL)} 条基础片段库 + 40 条规则的成对片段），"
      "行业差异通过金额、期限、担保方式、用途与条款抽样体现，不代表真实行业合同文本。")
    a("4. `labels/split.json` 与 `labels/type_map.yaml` 不是标注文件；`validate_labels.py` 已按文件名跳过它们。")
    a("")
    return "\n".join(lines)


# ---------------------------------------------------------------- 自检


def verify_contract(c: dict, clauses: list[dict], label: dict) -> list[str]:
    problems: list[str] = []
    cid = c["cid"]
    if not (90 <= len(clauses) <= 110):
        problems.append(f"{cid} 条款数 {len(clauses)} 越界（应 90-110）")
    total = sum(len(cl["text"]) for cl in clauses)
    if not (10000 <= total <= 14000):
        problems.append(f"{cid} 字数 {total} 越界（应 10000-14000）")
    for i, cl in enumerate(clauses, 1):
        if cl["clause_id"] != f"{cid}-{i:03d}":
            problems.append(f"{cid} clause_id 不连续: {cl['clause_id']}")
        if cl["clause_no"] != clause_no(i):
            problems.append(f"{cid} 第 {i} 条条款号不连续: {cl['clause_no']}")
        hits = re.findall(r"第[一二三四五六七八九十百零〇0-9]+条", cl["text"])
        if hits != [cl["clause_no"]]:
            problems.append(f"{cid} {cl['clause_id']} 正文含额外条款号: {hits}")
        if "\n" in cl["text"]:
            problems.append(f"{cid} {cl['clause_id']} 正文含换行")
    by_id = {cl["clause_id"]: cl for cl in clauses}
    for r in label["risks"]:
        cl = by_id.get(r["clause_id"])
        if cl is None:
            problems.append(f"{cid} {r['risk_id']} clause_id 不存在")
            continue
        text = cl["text"]
        if text.count(r["quote"]) != 1:
            problems.append(f"{cid} {r['risk_id']} quote 非唯一")
        if text[r["char_start"]:r["char_end"]] != r["quote"]:
            problems.append(f"{cid} {r['risk_id']} 偏移错误")
        if "第" in r["quote"] and re.search(r"第[一二三四五六七八九十百零〇0-9]+条", r["quote"]):
            problems.append(f"{cid} {r['risk_id']} quote 含条款号")
        if r["risk_level"] not in ("高", "中", "低"):
            problems.append(f"{cid} {r['risk_id']} 等级非法")
        if r["rule_id"] not in RULE_BY_ID:
            problems.append(f"{cid} {r['risk_id']} 规则不存在")
        if set(r.keys()) != {"risk_id", "clause_id", "clause_no", "risk_type", "rule_id",
                             "risk_level", "char_start", "char_end", "quote", "problem",
                             "suggestion", "legal_basis"}:
            problems.append(f"{cid} {r['risk_id']} 字段集不符 12 字段")

    # 40 条规则逐条核对：bad 只应出现在其植入条款里且仅一次；未植入的必须有 ok 条款
    texts = [cl["text"] for cl in clauses]
    bad_rules = {r["rule_id"] for r in label["risks"]}
    for rule in RULES:
        rid = rule["rule_id"]
        n_bad = sum(1 for t in texts if rule["bad"] in t)
        n_ok = sum(1 for t in texts if rule["ok"] in t)
        if rid in bad_rules:
            if n_bad != 1:
                problems.append(f"{cid} {rid} 植入条款的 bad 出现 {n_bad} 次（应恰为 1）")
            if n_ok != 0:
                problems.append(f"{cid} {rid} 已按 bad 植入，却仍出现合规表述 {n_ok} 次（自相矛盾）")
        else:
            if n_bad != 0:
                problems.append(f"{cid} {rid} 未植入却出现 bad {n_bad} 次")
            if n_ok < 1:
                problems.append(f"{cid} {rid} 缺少合规条款（ok）")
    if c["clean"] and label["risks"]:
        problems.append(f"{cid} 是 clean 合同却含 {len(label['risks'])} 条标注")
    return problems


def verify_docx(c: dict, clauses: list[dict], path: Path) -> list[str]:
    """回读 docx，确认每个条款在文档中是独立段落且文本完全一致（保证后续切分可复现）。"""
    problems: list[str] = []
    doc = Document(str(path))
    paras = [p.text for p in doc.paragraphs]
    cursor = 0
    for cl in clauses:
        found = -1
        for idx in range(cursor, len(paras)):
            if paras[idx] == cl["text"]:
                found = idx
                break
        if found < 0:
            problems.append(f"{c['cid']} docx 中找不到段落 {cl['clause_id']}")
        else:
            cursor = found + 1
    return problems


# ---------------------------------------------------------------- 入口


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="贷款合同审查评测数据集生成器")
    ap.add_argument("--out", default="data", help="输出根目录（默认 data）")
    ap.add_argument("--seed", type=int, default=42, help="随机种子（默认 42）")
    ap.add_argument("--no-verify", action="store_true", help="跳过生成后的自检")
    args = ap.parse_args(argv)

    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8")

    out = Path(args.out)
    seed = args.seed
    samples = out / "samples"
    boundary_dir = samples / "boundary"
    clauses_dir = out / "clauses"
    labels_dir = out / "labels"
    rules_dir = out / "rules"
    for d in (samples, boundary_dir, clauses_dir, labels_dir, rules_dir):
        d.mkdir(parents=True, exist_ok=True)

    # 0) 规则自检
    for r in RULES:
        re.compile(r["regex"])
        body_problem = r["common"] + r["bad"]
        body_ok = r["common"] + r["ok"]
        assert body_problem.count(r["bad"]) == 1, f"{r['rule_id']} quote 在问题表述中不唯一"
        assert body_ok.count(r["ok"]) == 1, f"{r['rule_id']} 合规表述不唯一"
        assert r["bad"] not in r["common"], f"{r['rule_id']} 问题表述与引言重复"
        assert not re.search(r"第[一二三四五六七八九十百零〇0-9]+条", body_problem), \
            f"{r['rule_id']} 片段含条款号"
        assert set(r["sug_keywords"]) and all(k in r["suggestion"] for k in r["sug_keywords"]), \
            f"{r['rule_id']} 建议关键词未出现在建议文本中"

    # 1) 名册补全文件名
    for c in CONTRACTS:
        c["filename"] = f"{c['cid']}_{c['client']}_{c['guarantee']}_{c['amount_short']}.docx"

    # 2) 植入编排
    plan = plan_plants(seed)

    # 3) 逐份生成
    stats_rows = []
    coverage: dict[str, list[str]] = {r["rule_id"]: [] for r in RULES}
    all_problems: list[str] = []
    labels_all: dict[str, dict] = {}
    clauses_all: dict[str, list[dict]] = {}

    for c in CONTRACTS:
        cid = c["cid"]
        clauses = assemble_clauses(c, plan[cid], seed)
        label = build_labels(c, clauses, plan[cid])
        labels_all[cid] = label
        clauses_all[cid] = clauses

        dump_json(clauses_dir / f"{cid}.json",
                  [{"clause_id": cl["clause_id"], "clause_no": cl["clause_no"], "text": cl["text"]}
                   for cl in clauses])
        dump_json(labels_dir / f"{cid}.json", label)

        docx_path = samples / c["filename"]
        write_contract_docx(c, clauses, docx_path)

        for r in label["risks"]:
            coverage[r["rule_id"]].append(cid)

        n = len(clauses)
        chars = sum(len(cl["text"]) for cl in clauses)
        rs = label["risk_summary"]
        stats_rows.append(dict(cid=cid, client=c["client"], amount=c["amount"],
                               guarantee=c["guarantee"], split=c["split"], n=n, chars=chars,
                               total=rs["total"], ok=len(RULES) - rs["total"],
                               high=rs["高"], mid=rs["中"], low=rs["低"]))
        all_problems.extend(verify_contract(c, clauses, label))
        if not args.no_verify:
            all_problems.extend(verify_docx(c, clauses, docx_path))

    # 4) 授信批复
    dump_json(samples / "credit_report_C03.json", CREDIT_REPORT)

    # 5) 边界样本（已存在则复用，避免无谓重写）
    if all((boundary_dir / fname).exists() for fname, _ in BOUNDARY_WRITERS):
        print("  边界样本已存在，复用（11 组）")
    else:
        for fname, writer in BOUNDARY_WRITERS:
            writer(boundary_dir / fname)
    tmp_dir = boundary_dir / "_tmp_b04"
    if tmp_dir.exists():
        for f in tmp_dir.glob("*.png"):
            f.unlink()
        tmp_dir.rmdir()

    # 6) 规则库 / 类型映射 / 划分
    #    rules.yaml 已被 classify_rules.py 追加 judge 字段，重新生成会覆盖它，
    #    因此已存在时保留不动；split.json 同理（要求保持不变）。
    rules_path = rules_dir / "rules.yaml"
    if rules_path.exists():
        print("  保留既有 rules/rules.yaml（含 judge 分类，不覆盖）")
    else:
        rules_doc = ["# 贷款合同审查规则库（40 条，四类各 10 条）",
                     "# 由 tools/gen_dataset.py 生成；legal_basis 一律 pending，禁止编造法规名称与文号。",
                     ""]
        body = yaml.safe_dump(build_rules_yaml(), allow_unicode=True, sort_keys=False,
                              default_flow_style=False, width=1000)
        rules_path.write_text("\n".join(rules_doc) + body, encoding="utf-8")

    type_map_doc = ["# 风险类型归一化映射", "# 结构：规范名 -> 别名列表；evaluate.py 按此把 risk_type 归一化后匹配。", ""]
    type_map_doc.append(yaml.safe_dump(TYPE_ALIASES, allow_unicode=True, sort_keys=False, width=1000))
    (labels_dir / "type_map.yaml").write_text("\n".join(type_map_doc), encoding="utf-8")

    split = {
        "dev": [c["cid"] for c in CONTRACTS if c["split"] == "dev"],
        "holdout": [c["cid"] for c in CONTRACTS if c["split"] == "holdout"],
        "clean": [c["cid"] for c in CONTRACTS if c["clean"]],
    }
    if (labels_dir / "split.json").exists():
        print("  保留既有 labels/split.json")
    else:
        dump_json(labels_dir / "split.json", split)

    # 7) README
    totals = dict(n=sum(r["n"] for r in stats_rows), chars=sum(r["chars"] for r in stats_rows),
                  total=sum(r["total"] for r in stats_rows), ok=sum(r["ok"] for r in stats_rows),
                  high=sum(r["high"] for r in stats_rows),
                  mid=sum(r["mid"] for r in stats_rows), low=sum(r["low"] for r in stats_rows))
    covered = sum(1 for rid, cids in coverage.items() if cids)
    n_files = 3 * len(CONTRACTS) + len(BOUNDARY_WRITERS) + 5
    stats = dict(seed=seed, contract_rows=stats_rows, totals=totals, split=split,
                 coverage=coverage, covered=covered, files=n_files)
    (out / "README.md").write_text(build_readme(stats), encoding="utf-8")

    # 8) 汇总
    print(f"输出目录: {out.resolve()}")
    print(f"seed={seed}  合同={len(CONTRACTS)}  规则={len(RULES)}  标注={totals['total']}")
    print(f"条款总数={totals['n']}  字数总计={totals['chars']}")
    print(f"等级分布: 高={totals['high']} 中={totals['mid']} 低={totals['low']}")
    print(f"规则覆盖: {covered}/40")
    print(f"划分: dev={len(split['dev'])} holdout={len(split['holdout'])} clean={len(split['clean'])}")
    print()
    print("| 合同 | 分组 | 条款数 | 字数 | 植入(bad) | 合规(ok) | 高 | 中 | 低 |")
    print("|---|---|---:|---:|---:|---:|---:|---:|---:|")
    for r in stats_rows:
        print(f"| {r['cid']} | {r['split']} | {r['n']} | {r['chars']} | {r['total']} | {r['ok']} | "
              f"{r['high']} | {r['mid']} | {r['low']} |")
    print()
    if all_problems:
        print(f"自检失败 {len(all_problems)} 项：")
        for p in all_problems[:50]:
            print("  -", p)
        return 2
    print("自检: 全部通过 ✅")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
