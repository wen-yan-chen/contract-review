CONTRACT_BY_ID = {c["cid"]: c for c in CONTRACTS}
SEP = "\u3000"  # 条款号与正文之间的全角空格


def _rng(seed: int, salt: str) -> random.Random:
    """按 seed + salt 派生独立随机流，保证与运行顺序无关。"""
    return random.Random(f"{seed}:{salt}")


# ---------------------------------------------------------------- 植入编排


def plan_plants(seed: int) -> dict[str, dict]:
    """为 16 份非干净合同编排植入规则；4 份 clean 不植入任何风险。

    本轮变化：每份合同都会包含全部 40 条规则的条款，只是形式不同——
    被选中的规则用 bad（问题表述，即标注的风险），其余用 ok（合规表述）。
    约束：非 clean 每份 3-8 条 bad，clean 为 0 条；同合同内同一规则不重复植入。
    """
    non_clean = [c["cid"] for c in CONTRACTS if not c["clean"]]
    rng = _rng(seed, "plan")
    order = [r["rule_id"] for r in rng.sample(RULES, len(RULES))]
    rid_index = {r["rule_id"]: i for i, r in enumerate(RULES)}

    assigned: dict[str, list[str]] = {cid: [] for cid in non_clean}

    # 第一轮：保证 40 条规则各出现一次（作为 bad 分布到不同合同）
    for i, rid in enumerate(order):
        assigned[non_clean[i % len(non_clean)]].append(rid)

    # 第二轮：按每份的目标条数补齐，同合同内不重复
    targets = {cid: rng.choice([4, 5, 5, 6, 6, 7, 8]) for cid in non_clean}
    pool = [r["rule_id"] for r in RULES]
    for cid in non_clean:
        while len(assigned[cid]) < targets[cid]:
            candidates = [r for r in pool if r not in assigned[cid]]
            assigned[cid].append(rng.choice(candidates))
        assigned[cid].sort(key=lambda rid: rid_index[rid])

    plan: dict[str, dict] = {c["cid"]: {"plants": assigned.get(c["cid"], [])}
                             for c in CONTRACTS}

    covered = {rid for cid in non_clean for rid in assigned[cid]}
    missing = {r["rule_id"] for r in RULES} - covered
    if missing:
        raise RuntimeError(f"规则覆盖不完整: {sorted(missing)}")
    for cid, rids in assigned.items():
        if not (3 <= len(rids) <= 8):
            raise RuntimeError(f"{cid} 植入条数越界: {len(rids)}")
        if len(set(rids)) != len(rids):
            raise RuntimeError(f"{cid} 存在重复规则")
    return plan


# ---------------------------------------------------------------- 条款拼装


def _render_blueprint(bp: dict, rng: random.Random, max_items: bool) -> str:
    items = bp["items"]
    lo = min(bp["min_items"], len(items))
    if max_items or len(items) <= lo:
        k = len(items)
    else:
        k = len(items) if rng.random() < 0.7 else rng.randint(lo, len(items) - 1)
    picked = sorted(rng.sample(range(len(items)), k))
    return bp["head"] + "".join(items[i] for i in picked) + bp.get("tail", "")


def _fill(text: str, c: dict) -> str:
    vars_ = dict(c)
    vars_["lender"] = LENDER
    vars_["sign_city"] = CITY
    vars_["repay_method"] = c["repay"]
    return text.format_map(vars_)


def _pair_body(rule: dict, planted: bool) -> str:
    return rule["common"] + (rule["bad"] if planted else rule["ok"])


def assemble_clauses(c: dict, plan_row: dict, seed: int) -> list[dict]:
    """拼装单份合同：40 条规则条款（bad 或 ok）+ 通用条款，满足 90-110 条 / 10000-14000 字。

    每条规则在合同中恰好落一个条款：被选中植入的用 bad，其余用 ok。
    这样模型报"未约定 X"时一定有原文可查，不会把正确判断算成误报。
    """
    cid = c["cid"]
    rng = _rng(seed, f"clauses:{cid}")
    has = lambda req: req is None or req in c["guarantee"]
    planted = set(plan_row["plants"])

    # 40 条规则逐条落条款（bad = 植入，ok = 合规对照）
    pairs: list[dict] = [{"kind": "pair", "rule_id": r["rule_id"], "section": r["section"],
                          "planted": r["rule_id"] in planted} for r in RULES]

    # 通用片段排除：与已植入规则的合规表述冲突，或自带某规则的问题表述
    banned = set(DIRTY_KEYS)
    for rid in planted:
        banned |= CONFLICTING_KEYS.get(rid, set())

    avail = [bp for bp in CLAUSE_POOL
             if has(bp["requires"]) and bp["key"] not in banned]
    by_sec: dict[str, list[dict]] = {s: [bp for bp in avail if bp["section"] == s] for s in SECTION_ORDER}

    n_rule = len(pairs)
    target_total = rng.randint(92, 108)
    n_base = max(20, min(len(avail), target_total - n_rule))

    # 按各章节可用片段数比例分配，每章至少 1 条
    total_avail = len(avail)
    alloc = {}
    for s in SECTION_ORDER:
        sec = by_sec[s]
        if not sec:
            alloc[s] = 0
            continue
        alloc[s] = max(1, round(n_base * len(sec) / total_avail))
        alloc[s] = min(alloc[s], len(sec))

    def slack(s):
        return len(by_sec[s]) - alloc[s]

    while sum(alloc.values()) > n_base:
        if all(alloc[s2] <= 1 for s2 in SECTION_ORDER):
            break
        s = max([x for x in SECTION_ORDER if alloc[x] > 1], key=lambda x: alloc[x])
        alloc[s] -= 1
    while sum(alloc.values()) < n_base:
        cands = [s for s in SECTION_ORDER if slack(s) > 0]
        if not cands:
            break
        s = max(cands, key=lambda x: len(by_sec[x]) - alloc[x])
        alloc[s] += 1

    chosen: list[dict] = []
    unused: dict[str, list[dict]] = {}
    for s in SECTION_ORDER:
        sec = by_sec[s][:]
        rng.shuffle(sec)
        take = sec[:alloc[s]]
        unused[s] = sec[alloc[s]:]
        for bp in take:
            chosen.append({"kind": "base", "section": s, "text": _render_blueprint(bp, rng, False),
                           "key": bp["key"]})

    def total_len() -> int:
        return (sum(len(x["text"]) for x in chosen)
                + sum(len(_pair_body(RULE_BY_ID[p["rule_id"]], p["planted"])) for p in pairs))

    # 长度不足：补入未使用的片段（取满条目），上限 110 条
    reserve = [bp for s in SECTION_ORDER for bp in unused[s]]
    rng.shuffle(reserve)
    while total_len() < 10000 and len(chosen) + n_rule < 110 and reserve:
        bp = reserve.pop()
        chosen.append({"kind": "base", "section": bp["section"],
                       "text": _render_blueprint(bp, rng, True), "key": bp["key"]})

    # 长度超限：删最长的通用条款，保持 >=90 条
    while total_len() > 14000 and len(chosen) + n_rule > 90 and chosen:
        longest = max(chosen, key=lambda x: len(x["text"]))
        chosen.remove(longest)

    for p in pairs:
        rule = RULE_BY_ID[p["rule_id"]]
        p["text"] = _pair_body(rule, p["planted"])

    # 按章节顺序合并，章内打乱
    grouped: dict[str, list[dict]] = {s: [] for s in SECTION_ORDER}
    for x in chosen:
        grouped[x["section"]].append(x)
    for p in pairs:
        grouped[p["section"]].append(p)
    merged: list[dict] = []
    for s in SECTION_ORDER:
        bucket = grouped[s]
        rng.shuffle(bucket)
        merged.extend(bucket)

    clauses = []
    for i, x in enumerate(merged, 1):
        cno = clause_no(i)
        text = _fill(cno + SEP + x["text"], c)
        clauses.append({"clause_id": f"{cid}-{i:03d}", "clause_no": cno, "text": text,
                        "section": x["section"], "kind": x["kind"],
                        "rule_id": x.get("rule_id"), "planted": x.get("planted")})
    return clauses


# ---------------------------------------------------------------- 标注


def build_labels(c: dict, clauses: list[dict], plan_row: dict) -> dict:
    cid = c["cid"]
    risks = []
    distractor_ids = []
    for cl in clauses:
        if cl["kind"] != "pair":
            continue
        rule = RULE_BY_ID[cl["rule_id"]]
        if not cl["planted"]:
            distractor_ids.append(cl["clause_id"])
            continue
        quote = rule["bad"]
        text = cl["text"]
        cnt = text.count(quote)
        if cnt != 1:
            raise RuntimeError(f"{cid} {cl['clause_id']} quote 出现 {cnt} 次")
        start = text.index(quote)
        risks.append({
            "risk_id": f"{cid}-R{len(risks) + 1:02d}",
            "clause_id": cl["clause_id"],
            "clause_no": cl["clause_no"],
            "risk_type": rule["risk_type"],
            "rule_id": rule["rule_id"],
            "risk_level": rule["level"],
            "char_start": start,
            "char_end": start + len(quote),
            "quote": quote,
            "problem": rule["problem"],
            "suggestion": rule["suggestion"],
            "legal_basis": {"name": "待核验", "verify_status": "pending", "url": ""},
        })

    checks = []
    if c["consistency"]:
        cc = c["consistency"]
        checks.append({
            "check_id": cc["check_id"],
            "field": cc["field"],
            "contract_value": cc["contract_value"],
            "credit_report_value": cc["credit_value"],
            "level": cc["level"],
            "note": cc["note"],
        })

    char_total = sum(len(cl["text"]) for cl in clauses)
    label = {
        "contract_id": cid,
        "file": f"samples/{c['filename']}",
        "perspective": "lender",
        "parser_version": PARSER_VERSION,
        "dataset_version": DATASET_VERSION,
        "clauses_total": len(clauses),
        "char_total": char_total,
        "industry": c["client"],
        "risk_summary": {
            "total": len(risks),
            "高": sum(1 for r in risks if r["risk_level"] == "高"),
            "中": sum(1 for r in risks if r["risk_level"] == "中"),
            "低": sum(1 for r in risks if r["risk_level"] == "低"),
        },
        "source_credit_report": ("samples/credit_report_C03.json" if c["consistency"] else None),
        "distractor_clause_ids": distractor_ids,
        "risks": risks,
        "consistency_checks": checks,
    }
    return label


# ---------------------------------------------------------------- docx 输出


def _style_run(run, size=10.5, bold=False, color=None):
    run.font.size = Pt(size)
    run.font.bold = bold
    run.font.name = "宋体"
    run._element.get_or_add_rPr().rFonts.set(qn("w:eastAsia"), "宋体")
    if color is not None:
        run.font.color.rgb = color


def _para(doc, text="", size=10.5, bold=False, align=None, indent=True,
          space_after=0, line_spacing=1.4, color=None):
    p = doc.add_paragraph()
    if align is not None:
        p.alignment = align
    pf = p.paragraph_format
    pf.space_before = Pt(0)
    pf.space_after = Pt(space_after)
    pf.line_spacing = line_spacing
    if indent:
        pf.first_line_indent = Pt(size * 2)
    run = p.add_run(text)
    _style_run(run, size=size, bold=bold, color=color)
    return p


def _init_doc():
    doc = Document()
    sec = doc.sections[0]
    sec.page_width, sec.page_height = Cm(21.0), Cm(29.7)
    sec.left_margin, sec.right_margin = Cm(3.17), Cm(3.17)
    sec.top_margin, sec.bottom_margin = Cm(2.54), Cm(2.54)
    normal = doc.styles["Normal"]
    normal.font.name = "宋体"
    normal.font.size = Pt(10.5)
    normal.element.get_or_add_rPr().rFonts.set(qn("w:eastAsia"), "宋体")
    return doc


def _normalize_docx(data: bytes) -> bytes:
    """重写 zip 条目时间戳与属性，消除保存时刻带来的字节差异。"""
    src = zipfile.ZipFile(io.BytesIO(data))
    out = io.BytesIO()
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as dst:
        for item in src.infolist():
            info = zipfile.ZipInfo(item.filename, date_time=(1980, 1, 1, 0, 0, 0))
            info.compress_type = zipfile.ZIP_DEFLATED
            info.external_attr = 0o600 << 16
            dst.writestr(info, src.read(item.filename))
    return out.getvalue()


def save_docx(doc, path: Path):
    props = doc.core_properties
    props.author = "gen_dataset.py"
    props.last_modified_by = "gen_dataset.py"
    props.title = ""
    props.subject = ""
    props.comments = ""
    props.keywords = ""
    props.category = ""
    props.revision = 1
    from datetime import datetime
    props.created = datetime(2026, 1, 1, 0, 0, 0)
    props.modified = datetime(2026, 1, 1, 0, 0, 0)
    buf = io.BytesIO()
    doc.save(buf)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(_normalize_docx(buf.getvalue()))


def write_contract_docx(c: dict, clauses: list[dict], path: Path):
    doc = _init_doc()
    doc.sections[0].header.paragraphs[0].text = f"合同编号：{c['contract_no']}"
    _style_run(doc.sections[0].header.paragraphs[0].runs[0], size=9,
               color=RGBColor(0x66, 0x66, 0x66))
    footer_p = doc.sections[0].footer.paragraphs[0]
    footer_p.text = DISCLAIMER
    _style_run(footer_p.runs[0], size=8, color=RGBColor(0x66, 0x66, 0x66))

    _para(doc, c["title"], size=16, bold=True, align=WD_ALIGN_PARAGRAPH.CENTER,
          indent=False, space_after=4)
    _para(doc, f"（模拟样本 {c['cid']} · 全部主体与数据均为虚构）", size=9,
          align=WD_ALIGN_PARAGRAPH.CENTER, indent=False, space_after=10,
          color=RGBColor(0x66, 0x66, 0x66))

    info = [
        ("合同编号", c["contract_no"]),
        ("借款人", c["borrower"]),
        ("贷款人", LENDER),
        ("借款金额", f"人民币{c['amount']}"),
        ("借款期限", f"{c['term']}个月"),
        ("担保方式", c["guarantee"]),
        ("签订地点", CITY),
        ("签订日期", c["sign_date"]),
    ]
    for k, v in info:
        _para(doc, f"{k}：{v}", size=10.5, indent=False, space_after=2, line_spacing=1.25)
    _para(doc, "", size=10.5, indent=False, space_after=6)

    for cl in clauses:
        _para(doc, cl["text"], size=10.5, indent=True, space_after=3, line_spacing=1.45)

    doc.add_page_break()
    _para(doc, "（以下为签署页，无正文）", size=10.5, indent=False,
          align=WD_ALIGN_PARAGRAPH.CENTER, space_after=12,
          color=RGBColor(0x66, 0x66, 0x66))
    for role, name in (("借款人", c["rep"]), ("贷款人", c["rep2"])):
        _para(doc, f"{role}（盖章）：", size=10.5, indent=False, space_after=6, line_spacing=1.6)
        _para(doc, f"法定代表人或授权代表（签字）：{name}", size=10.5, indent=False,
              space_after=6, line_spacing=1.6)
        _para(doc, f"日期：{c['sign_date']}", size=10.5, indent=False, space_after=18,
              line_spacing=1.6)
    _para(doc, DISCLAIMER, size=8, indent=False, space_after=0,
          color=RGBColor(0x66, 0x66, 0x66))
    save_docx(doc, path)


