for _bp in CLAUSE_POOL:
    _bp["items"].extend(EXTRA_ITEMS.get(_bp["key"], []))
    if not _bp.get("tail"):
        _bp["tail"] = TAILS.get(_bp["key"], "")

del _bp


def _bp_full_text(bp: dict) -> str:
    """片段的"满配"文本，用于判断它是否与某条规则条款语义冲突。"""
    return bp["head"] + "".join(bp["items"]) + bp.get("tail", "")


_POOL_FULL = {bp["key"]: _bp_full_text(bp) for bp in CLAUSE_POOL}

# 语义冲突映射：这些通用片段与规则的"问题表述"讲的是同一件事、但立场相反，
# 若该规则被植入（bad），必须把对应通用片段从这份合同中剔除，
# 否则会出现「约定登记」与「无登记义务」并存的矛盾条款，标注就失去意义。
SEMANTIC_CONFLICTS = {
    "R01": ["i_rate", "i_repricing"],
    "R02": ["i_penalty"],
    "R03": ["i_interest"],
    "R04": ["i_compound"],
    "R05": ["i_repricing"],
    "R06": ["i_interest"],
    "R07": ["i_repricing"],
    "R08": ["i_fee", "i_cost"],
    "R09": ["i_early", "p_calc"],
    "R11": ["g_guarantee"],
    "R12": ["g_type", "g_guarantee"],
    "R13": ["g_guarantee"],
    "R14": ["g_mortgage"],
    "R15": ["g_value"],
    "R17": ["g_pledge"],
    "R20": ["b_remedy"],
    "R21": ["b_events", "b_notice"],
    "R22": ["b_accel", "b_remedy"],
    "R23": ["b_liquidated"],
    "R24": ["i_penalty", "b_liquidated"],
    "R25": ["b_notice", "r_overdue"],
    "R26": ["b_cross"],
    "R27": ["b_liquidated"],
    "R29": ["b_force"],
    "R30": ["o_amend"],
    "R33": ["j_court", "j_negotiate"],
    "R34": ["j_court"],
    "R35": ["n_address", "n_method"],
    "R36": ["k_privacy", "k_thirdparty"],
    "R37": ["k_crossborder", "k_thirdparty"],
    "R39": ["i_cost", "i_fee"],
}

# 冲突消解（语义映射 + 自动推导，双保险）：
#   1) 通用片段正文里若逐字写了某规则的 bad —— 任何合同都不能用，否则会凭空多出一处未标注的风险；
#   2) 通用片段正文里若逐字写了某规则的 ok —— 该规则被植入（bad）时必须排除。
CONFLICTING_KEYS: dict[str, set[str]] = {}
for _r in RULES:
    _keys = {k for k, t in _POOL_FULL.items() if _r["ok"] and _r["ok"] in t}
    _keys |= set(SEMANTIC_CONFLICTS.get(_r["rule_id"], []))
    if _keys:
        CONFLICTING_KEYS[_r["rule_id"]] = _keys
DIRTY_KEYS: set[str] = set()
for _r in RULES:
    DIRTY_KEYS |= {k for k, t in _POOL_FULL.items() if _r["bad"] and _r["bad"] in t}

del _r, _keys

# ---------------------------------------------------------------- 合同名册
# 全部为虚构主体，名称统一带「（模拟）」标记，不含任何真实企业或个人信息。

