r"""贷款合同审查评测数据集生成器（单一入口 / 可重复运行 / 确定性输出）。

用法：
    python tools/gen_dataset.py --out data --seed 42

产物（相对 --out 目录）：
    samples/C01..C20*.docx            20 份自造贷款合同
    samples/boundary/B01..B11*.docx   11 组边界样本
    samples/credit_report_C03.json    授信批复（含 3 处不一致）
    clauses/C01..C20.json             条款表 [{clause_id, clause_no, text}]
    labels/C01..C20.json              标注（每条风险 12 个字段）
    labels/split.json                 dev / holdout / clean 划分
    labels/type_map.yaml              风险类型归一化映射
    rules/rules.yaml                  40 条规则（利率/担保/违约/合规 各 10 条）
    README.md                         数据说明

设计要点
--------
1. 条款片段库带类型标签；植入采用「合规表述 -> 问题表述」成对映射，
   合规版同时充当"干净但易误报"的干扰条款。
2. char_start / char_end 全部由程序在条款正文上 index() 求出，禁止人工填写。
3. quote 在所属条款正文中必须恰好出现一次，且不含「第X条」。
4. 所有 docx 在保存后统一改写 zip 时间戳与文档属性，保证同 seed 两次运行逐字节一致。
5. 全部企业、个人、编号、地址均为虚构占位；法规依据一律 pending，不编造名称与文号。
"""

from __future__ import annotations

import argparse
import io
import json
import random
import re
import sys
import zipfile
from pathlib import Path

import yaml
from docx import Document
from docx.enum.table import WD_TABLE_ALIGNMENT
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.oxml.ns import qn
from docx.shared import Cm, Pt, RGBColor

DATASET_VERSION = "gen-v2"
PARSER_VERSION = "split-v1"

LENDER = "示例商业银行示例分行"
CITY = "示例市"
DISCLAIMER = "本文件为模拟数据，仅供评测与教学使用，不构成任何真实法律文件。"

# ---------------------------------------------------------------- 中文数字

_CN_DIGITS = "零一二三四五六七八九"
_CN_CAP = "零壹贰叁肆伍陆柒捌玖"
_CN_UNITS = ["", "拾", "佰", "仟"]
_CN_BIG = ["", "万", "亿"]


def cn_num(n: int) -> str:
    """1 -> 一，12 -> 十二，120 -> 一百二十。用于「第X条」。"""
    if n <= 0:
        raise ValueError("条款序号必须为正整数")
    if n < 10:
        return _CN_DIGITS[n]
    if n < 20:
        return "十" + (_CN_DIGITS[n - 10] if n > 10 else "")
    if n < 100:
        t, o = divmod(n, 10)
        return _CN_DIGITS[t] + "十" + (_CN_DIGITS[o] if o else "")
    if n < 1000:
        h, r = divmod(n, 100)
        s = _CN_DIGITS[h] + "百"
        if r == 0:
            return s
        if r < 10:
            return s + "零" + _CN_DIGITS[r]
        return s + cn_num(r)
    th, r = divmod(n, 1000)
    s = _CN_DIGITS[th] + "千"
    if r == 0:
        return s
    if r < 100:
        return s + "零" + cn_num(r)
    return s + cn_num(r)


def clause_no(n: int) -> str:
    return "第" + cn_num(n) + "条"


# ---------------------------------------------------------------- 规则库
# 每条规则都带一段「合规表述 / 问题表述」成对片段：ok 用于干净样本，
# bad 用于植入；标注的 quote 直接取 bad，偏移由程序计算。


def _rule(**kw):
    return kw


