    _para(doc, "示例商业银行示例分行　流动资金借款合同　　第 1 页 共 3 页", size=9, indent=False,
          align=WD_ALIGN_PARAGRAPH.CENTER, space_after=6, color=RGBColor(0x66, 0x66, 0x66))
    # 第七条被分页截断：前半段在本页末，后半段在下一页页首
    split_body = bodies[6]
    head, tail = split_body[: len(split_body) // 2], split_body[len(split_body) // 2:]
    _para(doc, f"{clause_no(7)}{SEP}{head}", size=10.5, indent=True, space_after=3, line_spacing=1.45)
    doc.add_page_break()
    _para(doc, "示例商业银行示例分行　流动资金借款合同　　第 2 页 共 3 页", size=9, indent=False,
          align=WD_ALIGN_PARAGRAPH.CENTER, space_after=6, color=RGBColor(0x66, 0x66, 0x66))
    _para(doc, tail, size=10.5, indent=True, space_after=3, line_spacing=1.45)
    for i, body in enumerate(bodies[7:], 8):
        _para(doc, f"{clause_no(i)}{SEP}{body}", size=10.5, indent=True, space_after=3, line_spacing=1.45)
    save_docx(doc, path)


