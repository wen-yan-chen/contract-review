BOUNDARY_NOTE = [
    ("B01", "无「第X条」，改用「一、二、」", "多锚点切分：二级锚点应能切出条款"),
    ("B02", "条款跨页断裂，正文夹带页眉与页码", "页眉页脚剥离与跨页拼接"),
    ("B03", "还款计划为表格", "表格文本化后仍可切分"),
    ("B04", "纯图片扫描件（无文字层）", "OCR 兜底，解析器应报『无文字层』而非静默空结果"),
    ("B05", "双栏排版", "阅读顺序：应先读完左栏再读右栏"),
    ("B06", "120 条超长合同", "性能与编号上限（≥ 一百二十）"),
    ("B07", "条款编号跳号/重复", "ID 稳定性：按出现顺序编号，不按条款号"),
    ("B08", "中英混排条款", "语言鲁棒性，英文不破坏锚点识别"),
    ("B09", "同一条含多个风险点", "一对多拆分：一条应能产出多条风险"),
    ("B10", "缺页/空白页", "容错与提示，不得把空白页当条款"),
    ("B11", "表格形式的担保清单", "结构化抽取：表格行→担保物列表"),
]


def _boundary_body(n: int, salt: str) -> list[str]:
    """从片段库取 n 条正文，用于边界样本。"""
    rng = _rng(2026, f"boundary:{salt}")
    pool = CLAUSE_POOL[:]
    rng.shuffle(pool)
    out = []
    for i in range(n):
        bp = pool[i % len(pool)]
        out.append(_render_blueprint(bp, rng, True))
    return out


def write_b01(path: Path):
    doc = _init_doc()
    _para(doc, "借款合同（边界样本 B01：无「第X条」锚点）", size=15, bold=True,
          align=WD_ALIGN_PARAGRAPH.CENTER, indent=False, space_after=10)
    _para(doc, "说明：本样本以「一、二、」编号，用于检验多锚点切分。", size=9,
          indent=False, space_after=10, color=RGBColor(0x66, 0x66, 0x66))
    marks = ["一", "二", "三", "四", "五", "六", "七", "八", "九", "十",
             "十一", "十二", "十三", "十四", "十五", "十六", "十七", "十八"]
    for mark, body in zip(marks, _boundary_body(len(marks), "b01")):
        _para(doc, f"{mark}、{body}", size=10.5, indent=True, space_after=3, line_spacing=1.45)
    save_docx(doc, path)


